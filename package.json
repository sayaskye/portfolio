{
  "name": "personal-portfolio-website",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.x",
  "scripts": {
    "dev": "astro dev",
    "build": "bun run validate:build && astro build",
    "build:skip-validation": "astro build",
    "validate:build": "bun run scripts/validate-build.ts",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . --ext .ts,.astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "astro check",
    "prepare": "husky"
  },
  "dependencies": {
    "astro": "^5.17.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "^1.1.13",
    "eslint": "^9.17.0",
    "eslint-plugin-astro": "^1.3.2",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  }
}
