---
interface Props {
  title: string;
  subtitle: string;
  eyebrow: string;
}

const { title, subtitle, eyebrow } = Astro.props;
---

<div class="mb-12 text-center">
  <h2 class="text-primary mb-2 text-base font-bold tracking-widest uppercase">
    {eyebrow}
  </h2>
  <h1 class="mb-4 text-4xl font-bold lg:text-5xl">{title}</h1>
  <p class="mx-auto max-w-2xl text-lg text-(--text-secondary)">
    {subtitle}
  </p>
</div>
