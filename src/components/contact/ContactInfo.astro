---
import { getTranslation } from '@/i18n';
import SocialLinks from '../ui/SocialLinks.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = (key: string) => getTranslation(key, lang);
---

<div class="relative z-10 mb-10 flex flex-col justify-center lg:mb-0 lg:w-1/2">
  <h3 class="mb-4 text-3xl font-bold text-(--text-primary)">
    {t('contact.page.card_title')}
  </h3>
  <p class="mb-8 text-lg text-(--text-secondary)">
    {t('contact.page.card_subtitle')}
  </p>

  <div class="space-y-6">
    <a
      class="hover:text-primary flex cursor-pointer items-center gap-4 text-(--text-primary) transition-colors"
      href="mailto:hello@zares.dev"
    >
      <div
        class="text-primary flex h-12 w-12 items-center justify-center rounded-full border border-(--border-color) bg-(--bg-primary)"
      >
        <Icon name="mail" class="size-6" />
      </div>
      <div>
        <p class="text-xs font-bold tracking-widest text-(--text-secondary) uppercase">
          {t('contact.page.email_label')}
        </p>
        <p class="font-medium text-(--text-primary)">hello@zares.dev</p>
      </div>
    </a>

    <div class="flex items-center gap-4 text-(--text-primary)">
      <div
        class="text-primary flex h-12 w-12 items-center justify-center rounded-full border border-(--border-color) bg-(--bg-primary)"
      >
        <Icon name="location_on" class="size-6" />
      </div>
      <div>
        <p class="text-xs font-bold tracking-widest text-(--text-secondary) uppercase">
          {t('contact.page.location_label')}
        </p>
        <p class="font-medium text-(--text-primary)">
          {t('contact.page.location_value')}
        </p>
      </div>
    </div>
  </div>

  <SocialLinks lang={lang} class="mt-12" />
</div>
