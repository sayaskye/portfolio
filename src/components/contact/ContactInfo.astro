---
import { getTranslation } from '@/i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = (key: string) => getTranslation(key, lang);
---

<div class="relative z-10 mb-10 flex flex-col justify-center lg:mb-0 lg:w-1/2">
  <h3 class="mb-4 text-3xl font-bold text-(--text-primary)">
    {t('contact.page.card_title')}
  </h3>
  <p class="mb-8 text-lg text-(--text-secondary)">
    {t('contact.page.card_subtitle')}
  </p>

  <div class="space-y-6">
    <a
      class="hover:text-primary flex cursor-pointer items-center gap-4 text-(--text-primary) transition-colors"
      href="mailto:hello@zares.dev"
    >
      <div
        class="text-primary flex h-12 w-12 items-center justify-center rounded-full border border-(--border-color) bg-(--bg-primary)"
      >
        <span class="material-symbols-outlined">mail</span>
      </div>
      <div>
        <p class="text-xs font-bold tracking-widest text-(--text-secondary) uppercase">
          {t('contact.page.email_label')}
        </p>
        <p class="font-medium text-(--text-primary)">hello@zares.dev</p>
      </div>
    </a>

    <div class="flex items-center gap-4 text-(--text-primary)">
      <div
        class="text-primary flex h-12 w-12 items-center justify-center rounded-full border border-(--border-color) bg-(--bg-primary)"
      >
        <span class="material-symbols-outlined">location_on</span>
      </div>
      <div>
        <p class="text-xs font-bold tracking-widest text-(--text-secondary) uppercase">
          {t('contact.page.location_label')}
        </p>
        <p class="font-medium text-(--text-primary)">
          {t('contact.page.location_value')}
        </p>
      </div>
    </div>
  </div>

  <div class="mt-12 flex gap-4">
    <a
      class="hover:bg-primary hover:text-on-primary flex h-12 w-12 cursor-pointer items-center justify-center rounded-xl border border-(--border-color) bg-(--bg-primary) text-(--text-primary) shadow-sm transition-all hover:-translate-y-1"
      href="https://github.com"
      aria-label={t('contact.page.social_github')}
    >
      <svg class="h-6 w-6 fill-current" viewBox="0 0 24 24">
        <path
          d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.041-1.416-4.041-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
        ></path>
      </svg>
    </a>
    <a
      class="hover:bg-primary hover:text-on-primary flex h-12 w-12 cursor-pointer items-center justify-center rounded-xl border border-(--border-color) bg-(--bg-primary) text-(--text-primary) shadow-sm transition-all hover:-translate-y-1"
      href="https://linkedin.com"
      aria-label={t('contact.page.social_linkedin')}
    >
      <svg class="h-6 w-6 fill-current" viewBox="0 0 24 24">
        <path
          d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
        ></path>
      </svg>
    </a>
  </div>
</div>
