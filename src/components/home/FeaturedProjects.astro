---
import { getTranslation } from '@/i18n';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import FeaturedProjectHero from '@/components/projects/FeaturedProjectHero.astro';
import Icon from '@/components/ui/Icon.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: string;
  projects: CollectionEntry<'projects'>[];
}

const { lang, projects } = Astro.props;
const t = (key: string) => getTranslation(key, lang);

// Find the latest featured project
const featuredProject = projects
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())[0];
---

<section class="bg-(--bg-primary) py-24 transition-colors duration-300" id="projects">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-12 flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <SectionHeader
        eyebrow={t('home.featured_projects.eyebrow')}
        title={t('home.featured_projects.title')}
        description={t('home.featured_projects.subtitle')}
      />
      <a
        class="text-primary inline-flex items-center font-bold hover:underline"
        href={`/${lang}/projects/`}
      >
        {t('home.featured_projects.view_all')}
        <Icon name="arrow_forward" class="ml-2 size-5" />
      </a>
    </div>

    {
      featuredProject && (
        <FeaturedProjectHero project={featuredProject} lang={lang} hideLabel={true} />
      )
    }
  </div>
</section>
