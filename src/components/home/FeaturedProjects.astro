---
import { getTranslation } from '@/i18n';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import Icon from '@/components/ui/Icon.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: string;
  projects: CollectionEntry<'projects'>[];
}

const { lang, projects } = Astro.props;
const t = (key: string) => getTranslation(key, lang);
---

<section class="bg-(--bg-primary) py-24" id="projects">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-16 flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <SectionHeader
        eyebrow={t('home.featured_projects.eyebrow')}
        title={t('common.nav.projects')}
        description={t('home.featured_projects.subtitle')}
      />
      <a
        class="text-primary inline-flex items-center font-bold hover:underline"
        href={`/${lang}/projects/`}
      >
        {t('home.featured_projects.view_all')}
        <Icon name="arrow_forward" class="ml-2 size-5" />
      </a>
    </div>

    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project, idx) => {
          const imgSrc = project.data.image ? project.data.image.src : '';
          const blendClass = idx % 2 === 0 ? 'bg-primary/20' : 'bg-secondary/20';

          return (
            <ProjectCard project={project} lang={lang} imgSrc={imgSrc} blendClass={blendClass} />
          );
        })
      }
    </div>
  </div>
</section>
