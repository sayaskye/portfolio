---
import { getTranslation } from '@/i18n';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Milestone from '@/components/home/Milestone.astro';
import Icon from '@/components/ui/Icon.astro';
import { getCollection } from 'astro:content';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = (key: string) => getTranslation(key, lang);

const experienceEntries = await getCollection('experience', (entry) => {
  return entry.data.language === lang;
});

// Sort and pre-render content
const processedExperience = await Promise.all(
  experienceEntries
    .sort((a, b) => b.data.sortDate.getTime() - a.data.sortDate.getTime())
    .map(async (item) => {
      const { Content } = await item.render();
      return { item, Content };
    })
);
---

<section class="py-24 transition-colors duration-300" id="experience">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-16 lg:grid-cols-3">
      <div>
        <SectionHeader
          eyebrow={t('home.experience.eyebrow')}
          title={t('home.experience.title')}
          className="mb-6"
        />
        <p class="mb-8 leading-relaxed text-(--text-secondary) transition-colors duration-300">
          {t('home.experience.subtitle')}
        </p>
        <!-- Key Achievement callout -->
        <div
          class="border-primary/20 bg-primary/5 rounded-xl border p-6 transition-colors duration-300"
        >
          <h5 class="text-primary mb-2 flex items-center gap-2 font-bold">
            <Icon name="award_star" class="size-5" />
            {t('home.experience.achievement_title')}
          </h5>
          <p class="text-sm text-(--text-secondary) italic transition-colors duration-300">
            {t('home.experience.achievement_desc')}
          </p>
        </div>
      </div>
      <div class="relative flex flex-col gap-12 lg:col-span-2">
        <div class="flex flex-col gap-12" id="experience-timeline">
          {
            processedExperience.map(({ item, Content }, idx) => (
              <div
                class:list={[
                  'experience-item transition-all duration-500',
                  idx >= 2 && 'hidden translate-y-4 opacity-0',
                ]}
              >
                <Milestone
                  date={item.data.displayDate}
                  role={item.data.role}
                  company={item.data.company}
                  icon={item.data.icon}
                  variant={idx === 0 ? 'primary' : 'secondary'}
                >
                  <Content />
                </Milestone>
              </div>
            ))
          }
        </div>

        {
          processedExperience.length > 2 && (
            <div class="mt-4 flex justify-center lg:justify-start">
              <button
                id="toggle-experience"
                data-text-more={t('home.experience.view_all')}
                data-text-less={t('home.experience.view_less')}
                class="bg-primary/10 text-primary hover:bg-primary hover:text-on-primary group flex cursor-pointer items-center justify-center gap-2 rounded-full px-8 py-3 font-bold transition-all duration-300"
              >
                <span id="toggle-text">{t('home.experience.view_all')}</span>
                <Icon
                  name="arrow_forward"
                  class="toggle-icon size-5 transition-transform duration-300"
                />
              </button>
            </div>
          )
        }
      </div>

      <script>
        function setupExperienceToggle() {
          const btn = document.getElementById('toggle-experience');
          if (!btn) return;

          const items = document.querySelectorAll('.experience-item');
          const text = document.getElementById('toggle-text');
          const icon = btn.querySelector('.toggle-icon');

          const textMore = btn.getAttribute('data-text-more');
          const textLess = btn.getAttribute('data-text-less');

          let isExpanded = false;

          btn.addEventListener('click', () => {
            isExpanded = !isExpanded;

            items.forEach((item, idx) => {
              if (idx >= 2) {
                if (isExpanded) {
                  item.classList.remove('hidden');
                  // Trigger layout reflow for animation
                  setTimeout(() => {
                    item.classList.remove('opacity-0', 'translate-y-4');
                  }, 10);
                } else {
                  item.classList.add('opacity-0', 'translate-y-4');
                  setTimeout(() => {
                    item.classList.add('hidden');
                  }, 500);
                }
              }
            });

            if (text && textMore && textLess) {
              text.textContent = isExpanded ? textLess : textMore;
            }

            if (icon) {
              icon.classList.toggle('rotate-90', isExpanded);
            }
          });
        }

        // Initialize on page load and view transitions
        document.addEventListener('astro:page-load', setupExperienceToggle);
      </script>
    </div>
  </div>
</section>
