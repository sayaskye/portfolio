---
import { getTranslation } from '@/i18n';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Milestone from '@/components/home/Milestone.astro';
import Icon from '@/components/ui/Icon.astro';
import { getCollection } from 'astro:content';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = (key: string) => getTranslation(key, lang);

const experienceEntries = await getCollection('experience', (entry) => {
  return entry.data.language === lang;
});

// Sort and pre-render content
const processedExperience = await Promise.all(
  experienceEntries
    .sort((a, b) => b.data.sortDate.getTime() - a.data.sortDate.getTime())
    .map(async (item) => {
      const { Content } = await item.render();
      return { item, Content };
    })
);
---

<section class="py-24 transition-colors duration-300" id="experience">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-16 lg:grid-cols-3">
      <div>
        <SectionHeader
          eyebrow={t('home.experience.eyebrow')}
          title={t('home.experience.title')}
          className="mb-6"
        />
        <p class="mb-8 leading-relaxed text-(--text-secondary) transition-colors duration-300">
          {t('home.experience.subtitle')}
        </p>
        <!-- Key Achievement callout -->
        <div class="border-primary/20 bg-primary/5 rounded-xl border p-6 transition-colors duration-300">
          <h5 class="text-primary mb-2 flex items-center gap-2 font-bold">
            <Icon name="award_star" class="size-5" />
            {t('home.experience.achievement_title')}
          </h5>
          <p class="text-sm text-(--text-secondary) italic transition-colors duration-300">
            {t('home.experience.achievement_desc')}
          </p>
        </div>
      </div>
      <div class="relative flex flex-col gap-12 lg:col-span-2">
        {
          processedExperience.map(({ item, Content }, idx) => (
            <Milestone
              date={item.data.displayDate}
              role={item.data.role}
              company={item.data.company}
              icon={item.data.icon}
              variant={idx === 0 ? 'primary' : 'secondary'}
            >
              <Content />
            </Milestone>
          ))
        }
      </div>
    </div>
  </div>
</section>
