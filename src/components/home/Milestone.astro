---
import Icon from '../ui/Icon.astro';

interface Props {
  date: string;
  role: string;
  company: string;
  icon: string;
  variant?: 'primary' | 'secondary';
}

const { date, role, company, icon, variant = 'primary' } = Astro.props;

const variantClasses = {
  primary: 'border-primary/30 bg-primary/10 text-primary',
  secondary: 'border-(--border-color) bg-(--bg-secondary) text-(--text-secondary)',
};
---

<div class="group relative pl-16 md:pl-28">
  <!-- Timeline Dot/Icon -->
  <div
    class={`absolute top-0 left-0 z-10 flex h-10 w-10 items-center justify-center rounded-xl border-2 border-(--bg-primary) bg-(--bg-primary) shadow-sm transition-all duration-500 group-hover:scale-110 group-hover:shadow-lg md:h-14 md:w-14 ${variantClasses[variant]}`}
  >
    <div
      class="bg-primary absolute -top-1 -right-1 z-20 h-3 w-3 rounded-full border-2 border-(--bg-primary) opacity-0 transition-all duration-300 group-hover:opacity-100"
    >
    </div>
    <Icon name={icon} class="size-5 md:size-7" />
  </div>

  <div class="transition-all duration-300 group-hover:translate-x-1">
    <div class="flex flex-col gap-0.5">
      <div class="flex items-center gap-3">
        <span
          class={`text-[10px] font-black tracking-[0.2em] uppercase ${variant === 'primary' ? 'text-primary' : 'text-(--text-secondary)'}`}
        >
          {date}
        </span>
        <span class="h-px w-8 bg-(--border-color) opacity-50"></span>
      </div>
      <h4
        class="group-hover:text-primary text-xl font-bold tracking-tight text-(--text-primary) transition-colors md:text-2xl"
      >
        {role}
      </h4>
      <p
        class="font-semibold text-(--text-secondary) transition-colors group-hover:text-(--text-primary)"
      >
        {company}
      </p>
      <div class="prose prose-sm prose-invert mt-4 max-w-none text-(--text-secondary)">
        <slot />
      </div>
    </div>
  </div>
</div>
