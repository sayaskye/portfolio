---
import Icon from '../ui/Icon.astro';

interface Props {
  date: string;
  role: string;
  company: string;
  icon: string;
  variant?: 'primary' | 'secondary';
}

const { date, role, company, icon, variant = 'primary' } = Astro.props;

const variantClasses = {
  primary: 'bg-primary/20 text-primary',
  secondary: 'bg-secondary/20 text-secondary',
};
---

<div class="relative pl-12 md:pl-24">
  <div
    class={`absolute top-1.5 left-0 z-10 flex h-10 w-10 items-center justify-center rounded-full border-4 border-(--bg-primary) md:-left-5 md:h-20 md:w-20 ${variantClasses[variant]}`}
  >
    <Icon name={icon} class="size-6 md:size-10" />
  </div>

  <div>
    <span
      class={`${variant === 'primary' ? 'text-primary' : 'text-secondary'} text-xs font-bold tracking-widest uppercase`}
    >
      {date}
    </span>
    <h4 class="mt-1 text-2xl font-bold">{role}</h4>
    <p class="mb-4 font-medium text-(--text-secondary)">
      {company}
    </p>
  </div>
</div>
