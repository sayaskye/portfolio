---
import { getTranslation } from '@/i18n';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = (key: string) => getTranslation(key, lang);

const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-(--border-color) bg-(--bg-primary) py-8">
  <div class="container mx-auto px-4">
    <div class="flex flex-col items-center justify-between gap-4 md:flex-row">
      <!-- Copyright -->
      <p class="text-sm text-(--text-secondary)">
        © {currentYear} {t('common.footer.brand')}. {t('common.footer.rights')}
      </p>

      <!-- Footer Links -->
      <ul class="flex items-center gap-6">
        <li>
          <a
            href={`/${lang}/`}
            class="cursor-pointer text-sm text-(--text-secondary) transition-colors hover:text-(--text-primary)"
          >
            {t('common.nav.home')}
          </a>
        </li>
        <li>
          <a
            href={`/${lang}/projects/`}
            class="cursor-pointer text-sm text-(--text-secondary) transition-colors hover:text-(--text-primary)"
          >
            {t('common.nav.projects')}
          </a>
        </li>
        <li>
          <a
            href={`/${lang}/contact/`}
            class="cursor-pointer text-sm text-(--text-secondary) transition-colors hover:text-(--text-primary)"
          >
            {t('common.nav.contact')}
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>
