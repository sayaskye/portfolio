---
import { getTranslation } from '@/i18n';
import SocialLinks from '../ui/SocialLinks.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = (key: string) => getTranslation(key, lang);

const currentYear = new Date().getFullYear();
---

<footer
  class="mt-auto border-t border-(--border-color) bg-(--bg-primary) pt-16 pb-8 transition-colors duration-300"
>
  <div class="container mx-auto px-6 lg:px-20">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-3 lg:gap-8">
      <!-- Column 1: Brand -->
      <div class="col-span-1">
        <a
          href={`/${lang}/`}
          class="flex items-center gap-3 transition-all duration-300 hover:opacity-80"
        >
          <div class="flex size-10 items-center justify-center transition-opacity duration-300">
            <Icon name="logo" class="text-primary" />
          </div>
          <span
            class="font-display text-2xl font-bold tracking-tight text-(--text-primary) transition-colors duration-300"
          >
            {t('common.footer.brand')}
          </span>
        </a>
        <SocialLinks lang={lang} class="mt-8" />
      </div>

      <!-- Column 2: Navigation -->
      <div>
        <h3
          class="text-sm font-bold tracking-widest text-(--text-primary) uppercase transition-colors duration-300"
        >
          {t('common.footer.navigation') || 'Navigation'}
        </h3>
        <ul class="mt-6 space-y-4">
          <li>
            <a
              href={`/${lang}/`}
              class="hover:text-primary text-(--text-secondary) transition-colors duration-300"
            >
              {t('common.nav.home')}
            </a>
          </li>
          <li>
            <a
              href={`/${lang}/projects/`}
              class="hover:text-primary text-(--text-secondary) transition-colors duration-300"
            >
              {t('common.nav.projects')}
            </a>
          </li>
          <li>
            <a
              href={`/${lang}/blog/`}
              class="hover:text-primary text-(--text-secondary) transition-colors duration-300"
            >
              {t('common.nav.blog') || 'Blog'}
            </a>
          </li>
          <li>
            <a
              href={`/${lang}/contact/`}
              class="hover:text-primary text-(--text-secondary) transition-colors duration-300"
            >
              {t('common.nav.contact')}
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Contact/Legal -->
      <div>
        <h3
          class="text-sm font-bold tracking-widest text-(--text-primary) uppercase transition-colors duration-300"
        >
          {t('common.footer.contact') || 'Contact'}
        </h3>
        <ul class="mt-6 space-y-4">
          <li
            class="flex items-center gap-3 text-(--text-secondary) transition-colors duration-300"
          >
            <Icon name="mail" class="size-4" />
            <span class="transition-colors duration-300">hello@zares.dev</span>
          </li>
          <li
            class="flex items-center gap-3 text-(--text-secondary) transition-colors duration-300"
          >
            <Icon name="location_on" class="size-4" />
            <span class="transition-colors duration-300"
              >{t('common.footer.location') || 'Remote'} / México</span
            >
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div
      class="mt-16 flex flex-col items-center justify-between border-t border-(--border-color) pt-8 transition-colors duration-300 md:flex-row"
    >
      <p class="text-sm text-(--text-muted) transition-colors duration-300">
        © {currentYear}
        Andrés Cazares. {t('common.footer.rights')}
      </p>
    </div>
  </div>
</footer>
