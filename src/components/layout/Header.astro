---
import { getTranslation } from '@/i18n';
import LanguageSelector from '../ui/LanguageSelector.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';
import MobileMenu from './MobileMenu.astro';

interface Props {
  lang: string;
  langUrls?: Record<string, string>;
}

const { lang, langUrls } = Astro.props;

// Helper function for translations
const t = (key: string) => getTranslation(key, lang);

// Navigation links
const navLinks = [
  { href: `/${lang}/`, label: t('common.nav.home') },
  { href: `/${lang}/projects/`, label: t('common.nav.projects') },
  { href: `/${lang}/blog/`, label: t('common.nav.blog') || 'Blog' },
  { href: `/${lang}/contact/`, label: t('common.nav.contact') },
];

// Get current path for active link styling
const currentPath = Astro.url.pathname;
---

<header
  id="main-header"
  class="header-main fixed top-0 right-0 left-0 z-50 flex items-center justify-between border-b border-solid border-(--border-color) bg-(--bg-primary)/80 px-6 backdrop-blur-xl transition-all duration-300 lg:px-20"
>
  <div class="flex items-center gap-8">
    <a
      href={`/${lang}/`}
      class="text-primary flex cursor-pointer items-center gap-4 transition-opacity hover:opacity-80"
    >
      <div class="bg-primary/10 flex size-8 items-center justify-center rounded-lg">
        <span class="material-symbols-outlined">terminal</span>
      </div>
      <h2 class="font-display text-xl leading-tight font-bold tracking-tight text-(--text-primary)">
        {t('common.footer.brand')}
      </h2>
    </a>

    <nav class="hidden items-center gap-9 md:flex">
      {
        navLinks.map((link) => {
          const isActive =
            currentPath === link.href ||
            (currentPath.startsWith(link.href) && link.href !== `/${lang}/`);
          return (
            <a
              href={link.href}
              class={`hover:text-primary cursor-pointer text-sm font-medium transition-colors ${
                isActive ? 'text-primary' : 'text-(--text-secondary)'
              }`}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>
  </div>

  <div class="flex flex-1 items-center justify-end gap-3 md:gap-6">
    <div class="flex items-center gap-1 md:gap-3">
      <!-- Desktop selectors -->
      <div class="hidden items-center gap-3 sm:flex">
        <ThemeToggle lang={lang} />
        <LanguageSelector currentLang={lang} langUrls={langUrls} />
      </div>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-button"
      class="group relative flex size-10 items-center justify-center rounded-lg border border-(--border-color) bg-(--bg-secondary)/50 text-(--text-primary) transition-all hover:bg-(--bg-secondary) md:hidden"
      aria-label="Toggle Menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span
        class="material-symbols-outlined absolute transition-all duration-300 group-aria-expanded:scale-0 group-aria-expanded:opacity-0"
      >
        menu
      </span>
      <span
        class="material-symbols-outlined absolute scale-0 opacity-0 transition-all duration-300 group-aria-expanded:scale-100 group-aria-expanded:opacity-100"
      >
        close
      </span>
    </button>
  </div>
</header>

<MobileMenu lang={lang} navLinks={navLinks} currentPath={currentPath} langUrls={langUrls} />

<script>
  function setupHeaderScroll() {
    const header = document.getElementById('main-header');
    if (!header) return;

    const handleScroll = () => {
      if (window.scrollY > 10) {
        header.classList.add('scrolled');
      } else {
        header.classList.remove('scrolled');
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }

  setupHeaderScroll();
  document.addEventListener('astro:after-swap', setupHeaderScroll);
</script>

<style>
  .header-main {
    padding-top: 1rem;
    padding-bottom: 1rem;
  }

  .header-main.scrolled {
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
    background-color: var(--bg-primary, rgba(var(--bg-primary-rgb, 255, 255, 255), 0.95));
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }
</style>
