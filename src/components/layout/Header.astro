---
import { getTranslation } from '@/i18n';
import LanguageSelector from '../ui/LanguageSelector.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';

interface Props {
  lang: string;
  langUrls?: Record<string, string>;
}

const { lang, langUrls } = Astro.props;

// Helper function for translations
const t = (key: string) => getTranslation(key, lang);

// Navigation links
const navLinks = [
  { href: `/${lang}/`, label: t('common.nav.home') },
  { href: `/${lang}/projects/`, label: t('common.nav.projects') },
  { href: `/${lang}/blog/`, label: t('common.nav.blog') || 'Blog' },
  { href: `/${lang}/contact/`, label: t('common.nav.contact') },
];

// Get current path for active link styling
const currentPath = Astro.url.pathname;
---

<header
  class="sticky top-0 z-50 border-b border-(--border-color) bg-(--bg-primary)/95 backdrop-blur-sm"
>
  <nav class="container mx-auto flex items-center justify-between px-4 py-4">
    <!-- Logo/Brand -->
    <a
      href={`/${lang}/`}
      class="text-xl font-bold text-(--text-primary) transition-opacity hover:opacity-80"
    >
      Portfolio
    </a>

    <!-- Navigation Links -->
    <ul class="flex items-center gap-6">
      {
        navLinks.map((link) => {
          const isActive = currentPath === link.href || currentPath.startsWith(link.href);
          return (
            <li>
              <a
                href={link.href}
                class={`hover:text-primary-500 text-sm font-medium transition-colors ${
                  isActive ? 'text-primary-500' : 'text-(--text-secondary)'
                }`}
              >
                {link.label}
              </a>
            </li>
          );
        })
      }
    </ul>

    <div class="flex items-center gap-3">
      <ThemeToggle />
    </div>
    <div>
      <LanguageSelector currentLang={lang} langUrls={langUrls} />
    </div>
  </nav>
</header>
