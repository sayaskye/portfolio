---
import { getTranslation } from '@/i18n';
import LanguageSelector from '../ui/LanguageSelector.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';
import Icon from '../ui/Icon.astro';
import MobileMenu from './MobileMenu.astro';

import { SITE_CONFIG, type SupportedLanguage } from '@/config';

interface Props {
  lang: string;
  langUrls?: Record<string, string>;
}

const { lang, langUrls } = Astro.props;

// Helper function for translations
const t = (key: string) => getTranslation(key, lang);

// Navigation links
const navLinks = [
  { href: `/${lang}/`, label: t('common.nav.home') },
  { href: `/${lang}/projects/`, label: t('common.nav.projects') },
  { href: `/${lang}/blog/`, label: t('common.nav.blog') || 'Blog' },
  { href: `/${lang}/contact/`, label: t('common.nav.contact') },
];

const currentCvUrl = SITE_CONFIG.cvUrls[lang as SupportedLanguage] || SITE_CONFIG.cvUrls.en;

// Get current path for active link styling
const currentPath = Astro.url.pathname;
---

<header
  id="main-header"
  class="fixed top-0 right-0 left-0 z-50 flex items-center justify-between border-b border-solid border-(--border-color) bg-(--bg-primary)/80 p-4 px-6 backdrop-blur-xl transition-all duration-300 lg:px-20"
>
  <div class="flex items-center gap-8">
    <a
      href={`/${lang}/`}
      class="text-primary flex cursor-pointer items-center gap-4 transition-opacity duration-300 hover:opacity-80"
    >
      <div class="flex size-8 items-center justify-center transition-opacity duration-300">
        <Icon name="logo" class="text-primary" />
      </div>
      <h2
        class="font-display text-xl leading-tight font-bold tracking-tight text-(--text-primary) transition-colors duration-300 md:hidden"
      >
        {t('common.footer.brand')}
      </h2>
    </a>

    <nav class="hidden items-center gap-9 md:flex">
      {
        navLinks.map((link) => {
          const isActive =
            currentPath === link.href ||
            (currentPath.startsWith(link.href) && link.href !== `/${lang}/`);
          return (
            <a
              href={link.href}
              class={`hover:text-primary cursor-pointer text-sm font-medium transition-colors duration-300 ${
                isActive ? 'text-primary' : 'text-(--text-secondary)'
              }`}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>
  </div>

  <div class="flex flex-1 items-center justify-end gap-3 md:gap-6">
    <a
      href={currentCvUrl}
      target="_blank"
      rel="noopener noreferrer"
      download
      class="bg-primary/10 hover:bg-primary/20 text-primary border-primary/20 hidden cursor-pointer items-center gap-2 rounded-lg border border-solid px-4 py-2 text-sm font-bold transition-all duration-300 md:flex"
    >
      <Icon name="download" class="size-4" />
      {t('common.nav.download_cv')}
    </a>
    <div class="flex items-center gap-1 md:gap-3">
      <!-- Desktop selectors -->
      <div class="hidden items-center gap-3 md:flex">
        <ThemeToggle lang={lang} />
        <LanguageSelector currentLang={lang} langUrls={langUrls} />
      </div>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-button"
      class="group relative flex size-10 items-center justify-center rounded-lg border border-(--border-color) bg-(--bg-secondary)/50 text-(--text-primary) transition-all hover:bg-(--bg-secondary) md:hidden"
      aria-label="Toggle Menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Icon
        name="menu"
        class="absolute transition-all duration-300 group-aria-expanded:scale-0 group-aria-expanded:opacity-0"
      />
      <Icon
        name="close"
        class="absolute scale-0 opacity-0 transition-all duration-300 group-aria-expanded:scale-100 group-aria-expanded:opacity-100"
      />
    </button>
  </div>
</header>

<MobileMenu
  lang={lang}
  navLinks={navLinks}
  currentPath={currentPath}
  langUrls={langUrls}
  cvUrl={currentCvUrl}
/>
