---
import { getTranslation } from '@/i18n';
import type { CollectionEntry } from 'astro:content';
import Icon from '../ui/Icon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: string;
  imgSrc: string;
  blendClass: string;
}

const { project, lang, imgSrc, blendClass } = Astro.props;
const t = (key: string) => getTranslation(key, lang);
const slug = project.slug.replace(`${lang}/`, '');
---

<div
  class="group flex flex-col overflow-hidden rounded-xl border border-(--border-color) bg-(--bg-primary) transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl"
>
  <div class="relative h-56 overflow-hidden">
    <div class={`absolute inset-0 ${blendClass} z-10 mix-blend-overlay`}></div>
    <img
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
      alt={project.data.title}
      src={imgSrc}
    />
  </div>
  <div class="flex flex-1 flex-col p-8">
    <div class="mb-4 flex flex-wrap gap-2">
      {
        project.data.tags
          .slice(0, 3)
          .map((tag) => (
            <span class="rounded border border-(--border-color) bg-(--bg-secondary) px-2 py-1 text-[10px] font-bold text-(--text-secondary) uppercase transition-colors duration-300">
              {tag}
            </span>
          ))
      }
    </div>
    <h4
      class="group-hover:text-primary mb-2 text-xl font-bold text-(--text-primary) transition-colors"
    >
      {project.data.title}
    </h4>
    <p class="mb-6 text-sm leading-relaxed text-(--text-secondary) transition-colors duration-300">
      {project.data.description}
    </p>
    <div
      class="mt-auto flex items-center justify-between border-t border-(--border-color) pt-6 transition-colors duration-300"
    >
      <a
        class="hover:text-primary flex items-center gap-2 text-sm font-bold transition-all duration-300"
        href={`/${lang}/projects/${slug}/`}
      >
        <Icon name="link" class="size-5" />
        {t('home.featured_projects.case_study')}
      </a>
      {
        project.data.github && (
          <a
            class="text-(--text-secondary) transition-colors duration-300 hover:text-(--text-primary)"
            href={project.data.github}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="code" class="size-5" />
          </a>
        )
      }
    </div>
  </div>
</div>
