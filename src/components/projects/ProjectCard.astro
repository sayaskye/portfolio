---
import { getTranslation } from '@/i18n';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: string;
  imgSrc: string;
  blendClass: string;
}

const { project, lang, imgSrc, blendClass } = Astro.props;
const t = (key: string) => getTranslation(key, lang);
const slug = project.slug.replace(`${lang}/`, '');
---

<div class="group flex flex-col overflow-hidden rounded-xl border border-(--border-color) bg-(--bg-primary) transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl">
  <div class="relative h-56 overflow-hidden">
    <div class={`absolute inset-0 ${blendClass} z-10 mix-blend-overlay`} />
    <img
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
      alt={project.data.title}
      src={imgSrc}
    />
  </div>
  <div class="flex flex-1 flex-col p-8">
    <div class="mb-4 flex flex-wrap gap-2">
      {project.data.tags.slice(0, 3).map((tag) => (
        <span class="rounded border border-(--border-color) bg-(--bg-secondary) px-2 py-1 text-[10px] font-bold text-(--text-secondary) uppercase">
          {tag}
        </span>
      ))}
    </div>
    <h4 class="group-hover:text-primary mb-2 text-xl font-bold text-(--text-primary) transition-colors">
      {project.data.title}
    </h4>
    <p class="mb-6 text-sm leading-relaxed text-(--text-secondary)">
      {project.data.description}
    </p>
    <div class="mt-auto flex items-center justify-between border-t border-(--border-color) pt-6">
      <a
        class="hover:text-primary flex items-center gap-2 text-sm font-bold"
        href={`/${lang}/projects/${slug}/`}
      >
        <span class="material-symbols-outlined text-lg">link</span> {t('home.featured_projects.case_study')}
      </a>
      {project.data.github && (
        <a
          class="text-(--text-secondary) hover:text-(--text-primary)"
          href={project.data.github}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="material-symbols-outlined text-lg">code</span>
        </a>
      )}
    </div>
  </div>
</div>
