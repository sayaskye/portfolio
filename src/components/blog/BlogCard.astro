---
import { getTranslation } from '@/i18n';
import type { CollectionEntry } from 'astro:content';
import Icon from '../ui/Icon.astro';

interface Props {
  blog: CollectionEntry<'blog'>;
  lang: string;
  isFirst?: boolean;
}

const { blog, lang, isFirst = false } = Astro.props;
const t = (key: string) => getTranslation(key, lang);
const slug = blog.slug.replace(`${lang}/`, '');
---

<article
  class={`blog-card group grid grid-cols-1 items-start gap-8 md:grid-cols-12 transition-all duration-300 ${!isFirst ? 'border-t border-(--border-color) pt-16' : ''}`}
  data-category={blog.data.category}
>
  <div class="overflow-hidden rounded-xl md:col-span-4">
    {
      blog.data.image ? (
        <img
          src={blog.data.image.src}
          alt={blog.data.image.alt}
          class="aspect-video w-full object-cover transition-transform duration-300 group-hover:scale-105"
          transition:name={`blog-image-${blog.data.id}`}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="flex aspect-video w-full items-center justify-center bg-(--bg-secondary) transition-colors duration-300">
          <Icon name="article" class="size-12 text-(--text-muted) transition-colors duration-300" />
        </div>
      )
    }
  </div>
  <div class="flex flex-col gap-3 md:col-span-8">
    <div
      class="text-primary flex flex-wrap items-center gap-3 text-xs font-bold tracking-widest uppercase"
    >
      {
        blog.data.category && (
          <span class="bg-primary/10 rounded-full px-2 py-0.5 text-[10px]">
            {blog.data.category}
          </span>
        )
      }
      <span>
        {
          blog.data.publishDate.toLocaleDateString(lang, {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })
        }
      </span>
      {
        blog.data.tags && blog.data.tags.length > 0 && (
          <>
            <span class="h-1 w-1 rounded-full bg-slate-400" />
            <span>{blog.data.tags[0]}</span>
          </>
        )
      }
    </div>
    <h2
      class="group-hover:text-primary text-2xl leading-tight font-bold text-(--text-primary) transition-colors duration-300"
      transition:name={`blog-title-${blog.data.id}`}
    >
      <a href={`/${lang}/blog/${slug}/`}>{blog.data.title}</a>
    </h2>
    <p class="line-clamp-2 text-base leading-relaxed text-(--text-secondary) transition-colors duration-300">
      {blog.data.description}
    </p>
    <div class="mt-2 flex gap-4">
      {
        blog.data.tags
          .slice(1, 4)
          .map((tag) => (
            <span class="rounded bg-(--bg-secondary) px-2 py-1 text-xs text-(--text-secondary) transition-colors duration-300">
              {tag}
            </span>
          ))
      }
    </div>
    <div class="mt-4">
      <a
        class="text-primary inline-flex items-center gap-2 text-sm font-bold group-hover:underline"
        href={`/${lang}/blog/${slug}/`}
      >
        {t('blog.page.read_more')}
        <Icon name="arrow_forward" class="size-4" />
      </a>
    </div>
  </div>
</article>
