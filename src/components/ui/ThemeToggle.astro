---
// ThemeToggle component - switches between light and dark themes
import { getTranslation } from '@/i18n';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = (key: string) => getTranslation(key, lang);
---

<button
  id="theme-toggle"
  type="button"
  aria-label={t('common.theme.toggle')}
  class="cursor-pointer rounded-md p-2 transition-colors hover:bg-(--bg-secondary)"
>
  <svg
    id="theme-icon-light"
    class="hidden h-5 w-5"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
    ></path>
  </svg>
  <svg
    id="theme-icon-dark"
    class="hidden h-5 w-5"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
    ></path>
  </svg>
</button>

<script>
  import { getCurrentTheme, setTheme, getSupportedThemes } from '@/lib/theme';

  const button = document.getElementById('theme-toggle') as HTMLButtonElement;
  const lightIcon = document.getElementById('theme-icon-light') as unknown as SVGElement;
  const darkIcon = document.getElementById('theme-icon-dark') as unknown as SVGElement;

  function updateIcon(theme: string) {
    if (theme === 'dark') {
      lightIcon.classList.remove('hidden');
      darkIcon.classList.add('hidden');
    } else {
      lightIcon.classList.add('hidden');
      darkIcon.classList.remove('hidden');
    }
  }

  function toggleTheme() {
    const currentTheme = getCurrentTheme();
    const themes = getSupportedThemes();
    const currentIndex = themes.indexOf(currentTheme);
    const nextIndex = (currentIndex + 1) % themes.length;
    const nextTheme = themes[nextIndex];

    setTheme(nextTheme);
    updateIcon(nextTheme);
  }

  // Initialize icon based on current theme
  const initialTheme = getCurrentTheme();
  updateIcon(initialTheme);

  // Add click event listener
  button.addEventListener('click', toggleTheme);

  // Update icon when theme changes (e.g., from system preference)
  document.addEventListener('astro:page-load', () => {
    const theme = getCurrentTheme();
    updateIcon(theme);
  });
</script>
