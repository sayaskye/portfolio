---
// ThemeToggle component - switches between light and dark themes
import { getTranslation } from '@/i18n';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = (key: string) => getTranslation(key, lang);
---

<button
  type="button"
  aria-label={t('common.theme.toggle')}
  class="theme-toggle cursor-pointer rounded-md p-2 transition-colors hover:bg-(--bg-secondary)"
>
  <svg
    class="theme-icon-light hidden h-5 w-5"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
    ></path>
  </svg>
  <svg
    class="theme-icon-dark hidden h-5 w-5"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
    ></path>
  </svg>
</button>

<script>
  import { getCurrentTheme, setTheme, getSupportedThemes } from '@/lib/theme';

  function initThemeToggle(button: HTMLButtonElement) {
    const lightIcon = button.querySelector('.theme-icon-light') as SVGElement;
    const darkIcon = button.querySelector('.theme-icon-dark') as SVGElement;

    function updateIcons(theme: string) {
      if (theme === 'dark') {
        lightIcon?.classList.remove('hidden');
        darkIcon?.classList.add('hidden');
      } else {
        lightIcon?.classList.add('hidden');
        darkIcon?.classList.remove('hidden');
      }
    }

    button.addEventListener('click', () => {
      const themes = getSupportedThemes();
      const currentTheme = getCurrentTheme();
      const nextTheme = themes[(themes.indexOf(currentTheme) + 1) % themes.length];
      
      setTheme(nextTheme);
      // Update ALL toggles on the page
      document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach(btn => {
        const lIcon = btn.querySelector('.theme-icon-light');
        const dIcon = btn.querySelector('.theme-icon-dark');
        if (nextTheme === 'dark') {
          lIcon?.classList.remove('hidden');
          dIcon?.classList.add('hidden');
        } else {
          lIcon?.classList.add('hidden');
          dIcon?.classList.remove('hidden');
        }
      });
    });

    // Initial state
    updateIcons(getCurrentTheme());
  }

  function setup() {
    document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach(initThemeToggle);
  }

  setup();
  document.addEventListener('astro:page-load', setup);
</script>

