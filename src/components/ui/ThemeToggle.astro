---
// ThemeToggle component - switches between light and dark themes
import { getTranslation } from '@/i18n';
import Icon from './Icon.astro';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = (key: string) => getTranslation(key, lang);
---

<button
  type="button"
  aria-label={t('common.theme.toggle')}
  class="theme-toggle flex cursor-pointer items-center justify-center rounded-md p-2 transition-colors hover:bg-(--bg-secondary)"
>
  <Icon name="light_mode" class="theme-icon-light hidden size-5" />
  <Icon name="dark_mode" class="theme-icon-dark hidden size-5" />
</button>

<script>
  import { getCurrentTheme, setTheme, getSupportedThemes } from '@/lib/theme';

  function initThemeToggle(button: HTMLButtonElement) {
    const lightIcon = button.querySelector('.theme-icon-light') as HTMLElement;
    const darkIcon = button.querySelector('.theme-icon-dark') as HTMLElement;

    function updateIcons(theme: string) {
      if (theme === 'dark') {
        lightIcon?.classList.remove('hidden');
        darkIcon?.classList.add('hidden');
      } else {
        lightIcon?.classList.add('hidden');
        darkIcon?.classList.remove('hidden');
      }
    }

    button.addEventListener('click', () => {
      const themes = getSupportedThemes();
      const currentTheme = getCurrentTheme();
      const nextTheme = themes[(themes.indexOf(currentTheme) + 1) % themes.length];

      setTheme(nextTheme);
      // Update ALL toggles on the page
      document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((btn) => {
        const lIcon = btn.querySelector('.theme-icon-light');
        const dIcon = btn.querySelector('.theme-icon-dark');
        if (nextTheme === 'dark') {
          lIcon?.classList.remove('hidden');
          dIcon?.classList.add('hidden');
        } else {
          lIcon?.classList.add('hidden');
          dIcon?.classList.remove('hidden');
        }
      });
    });

    // Initial state
    updateIcons(getCurrentTheme());
  }

  function setup() {
    document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach(initThemeToggle);
  }

  // Initialize on every page load (first load and View Transition navigations)
  document.addEventListener('astro:page-load', setup);
</script>
