---
interface Props {
  eyebrow: string;
  title?: string;
  description?: string;
  align?: 'left' | 'center';
  className?: string;
}

const { eyebrow, title, description, align = 'left', className = '' } = Astro.props;
---

<div class={`${align === 'center' ? 'text-center mx-auto' : ''} ${className}`}>
  <h2 class="text-primary mb-2 text-base font-bold tracking-widest uppercase">
    {eyebrow}
  </h2>
  {title && <h3 class="text-4xl font-bold transition-colors duration-300">{title}</h3>}
  {
    description && (
      <p class="mt-4 max-w-2xl text-(--text-secondary) transition-colors duration-300">
        {description}
      </p>
    )
  }
</div>
