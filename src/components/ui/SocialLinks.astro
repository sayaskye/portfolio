---
import { getTranslation } from '@/i18n';
import Icon from './Icon.astro';

interface Props {
  lang: string;
  class?: string;
}

const { lang, class: className } = Astro.props;
const t = (key: string) => getTranslation(key, lang);

const socialLinks = [
  {
    name: 'github',
    href: 'https://github.com/sayaskye',
    ariaLabel: t('contact.page.social_github'),
  },
  {
    name: 'linkedin',
    href: 'https://linkedin.com/in/andres-cazares-web',
    ariaLabel: t('contact.page.social_linkedin'),
  },
];
---

<div class:list={['flex gap-4', className]}>
  {
    socialLinks.map((link) => (
      <a
        class="hover:bg-primary hover:text-on-primary flex h-12 w-12 cursor-pointer items-center justify-center rounded-xl border border-(--border-color) bg-(--bg-primary) text-(--text-primary) shadow-sm transition-all hover:-translate-y-1"
        href={link.href}
        aria-label={link.ariaLabel}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name={link.name} class="size-6" />
      </a>
    ))
  }
</div>
