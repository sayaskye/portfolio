---
// LanguageSelector component - switches between supported languages
import { getSupportedLanguages, getTranslation } from '@/i18n';
import type { LanguageCode } from '@/types/i18n';

interface Props {
  currentLang: string;
  langUrls?: Record<string, string>;
}

const { currentLang, langUrls } = Astro.props;
const t = (key: string) => getTranslation(key, currentLang as LanguageCode);
const supportedLanguages = getSupportedLanguages();

// Language display names
const languageNames: Record<string, string> = {
  en: 'EN',
  es: 'ES',
};
---

<div class="language-selector relative inline-block">
  <button
    type="button"
    aria-label={t('common.language.select')}
    aria-haspopup="true"
    aria-expanded="false"
    class="language-button cursor-pointer rounded-md px-3 py-2 font-medium transition-colors hover:bg-(--bg-secondary)"
  >
    {languageNames[currentLang] || currentLang.toUpperCase()}
  </button>

  <div
    class="language-menu ring-opacity-5 absolute left-0 z-10 mt-2 hidden w-24 rounded-md bg-(--bg-primary) shadow-lg ring-1 ring-(--border-color)"
    role="menu"
    aria-orientation="vertical"
  >
    <div class="py-1">
      {
        supportedLanguages.map((lang) => (
          <button
            type="button"
            data-lang={lang}
            data-lang-url={langUrls?.[lang]}
            class="language-option block w-full cursor-pointer px-4 py-2 text-left text-sm transition-colors hover:bg-(--bg-secondary)"
            class:list={[currentLang === lang && 'bg-(--bg-secondary) font-bold']}
            role="menuitem"
          >
            {languageNames[lang] || lang.toUpperCase()}
          </button>
        ))
      }
    </div>
  </div>
</div>

<script>
  import { setStoredLanguage } from '@/i18n/utils';
  import { navigate } from 'astro:transitions/client';

  function initLanguageSelector(container: HTMLElement) {
    const button = container.querySelector('.language-button') as HTMLButtonElement;
    const menu = container.querySelector('.language-menu') as HTMLDivElement;
    const options = container.querySelectorAll('.language-option') as NodeListOf<HTMLButtonElement>;

    if (!button || !menu) return;

    function toggleMenu() {
      const isExpanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
    }

    function closeMenu() {
      button.setAttribute('aria-expanded', 'false');
      menu.classList.add('hidden');
    }

    button.addEventListener('click', (e) => {
      e.stopPropagation();
      // Close other menus first
      document.querySelectorAll('.language-menu').forEach((m) => {
        if (m !== menu) m.classList.add('hidden');
      });
      document.querySelectorAll('.language-button').forEach((b) => {
        if (b !== button) b.setAttribute('aria-expanded', 'false');
      });
      toggleMenu();
    });

    options.forEach((option) => {
      option.addEventListener('click', () => {
        const lang = option.getAttribute('data-lang');
        const specificUrl = option.getAttribute('data-lang-url');
        if (lang) {
          switchLanguage(lang, specificUrl || undefined);
        }
      });
    });

    // Close on click outside
    document.addEventListener('click', (e) => {
      if (!container.contains(e.target as Node)) {
        closeMenu();
      }
    });

    // Close on escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });
  }

  function setup() {
    const selectors = document.querySelectorAll<HTMLElement>('.language-selector');
    selectors.forEach(initLanguageSelector);
  }

  function switchLanguage(lang: string, specificUrl?: string) {
    setStoredLanguage(lang);
    if (specificUrl) {
      navigate(specificUrl);
      return;
    }
    const currentPath = window.location.pathname;
    const pathSegments = currentPath.split('/').filter(Boolean);
    if (pathSegments.length > 0 && /^[a-z]{2}$/.test(pathSegments[0])) {
      pathSegments[0] = lang;
    } else {
      pathSegments.unshift(lang);
    }
    navigate('/' + pathSegments.join('/'));
  }

  // Initialize on every page load (first load and View Transition navigations)
  document.addEventListener('astro:page-load', setup);
</script>
