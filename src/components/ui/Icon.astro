---
/**
 * Icon Component
 * Loads SVGs from src/assets/icons/ and renders them inline.
 * Allows for easy styling with Tailwind classes.
 */
interface Props {
  name: string;
  class?: string;
  size?: number | string;
}

const { name, class: className = 'size-6', size } = Astro.props;

// Load all SVGs from the icons directory
const icons = import.meta.glob<{ default: string }>('/src/assets/icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const iconPath = `/src/assets/icons/${name}.svg`;
const rawSvg = icons[iconPath];

if (!rawSvg && import.meta.env.DEV) {
  console.warn(`Icon "${name}" not found in src/assets/icons/`);
}

// Inline style for custom sizes if provided
const style = size ? { width: typeof size === 'number' ? `${size}px` : size, height: typeof size === 'number' ? `${size}px` : size } : {};
---

{rawSvg ? (
  <div 
    class:list={['inline-flex items-center justify-center shrink-0', className]} 
    style={style}
    set:html={rawSvg} 
  />
) : (
  <span class="text-xs text-red-500">[Icon:{name}]</span>
)}

<style is:global>
  /* Ensure SVGs inside icons take the full container size and inherit color */
  .inline-flex svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
    display: block;
  }
  
  /* Ensure Tailwind's hidden class works even when inline-flex is present */
  .inline-flex.hidden {
    display: none !important;
  }
</style>

