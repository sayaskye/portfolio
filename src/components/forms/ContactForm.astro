---
// ContactForm component - handles contact form submission with validation and throttling
import { getTranslation } from '@/i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = (key: string) => getTranslation(key, lang);
---

<form id="contact-form" class="space-y-4">
  <div>
    <label for="contact-name" class="mb-2 block text-sm font-bold text-(--text-primary)">
      {t('contact.form.name')}
    </label>
    <input
      type="text"
      id="contact-name"
      name="name"
      required
      placeholder="John Doe"
      class="w-full rounded-lg border border-(--border-color) bg-(--bg-secondary) px-4 py-3 text-(--text-primary) placeholder:text-(--text-muted) outline-none transition-all focus:border-primary focus:ring-1 focus:ring-primary/20"
      aria-required="true"
    />
    <span id="name-error" class="mt-1 hidden text-sm text-red-500" role="alert"></span>
  </div>

  <div>
    <label for="contact-email" class="mb-2 block text-sm font-bold text-(--text-primary)">
      {t('contact.form.email')}
    </label>
    <input
      type="email"
      id="contact-email"
      name="email"
      required
      placeholder="john@example.com"
      class="w-full rounded-lg border border-(--border-color) bg-(--bg-secondary) px-4 py-3 text-(--text-primary) placeholder:text-(--text-muted) outline-none transition-all focus:border-primary focus:ring-1 focus:ring-primary/20"
      aria-required="true"
    />
    <span id="email-error" class="mt-1 hidden text-sm text-red-500" role="alert"></span>
  </div>

  <div>
    <label for="contact-message" class="mb-2 block text-sm font-bold text-(--text-primary)">
      {t('contact.form.message')}
    </label>
    <textarea
      id="contact-message"
      name="message"
      rows="4"
      required
      placeholder="Tell me about your project..."
      class="w-full resize-y rounded-lg border border-(--border-color) bg-(--bg-secondary) px-4 py-3 text-(--text-primary) placeholder:text-(--text-muted) outline-none transition-all focus:border-primary focus:ring-1 focus:ring-primary/20"
      aria-required="true"></textarea>
    <span id="message-error" class="mt-1 hidden text-sm text-red-500" role="alert"></span>
  </div>

  <button
    type="submit"
    id="contact-submit"
    class="w-full rounded-lg bg-primary py-4 text-base font-bold text-on-primary transition-opacity hover:opacity-90"
  >
    {t('common.actions.submit')}
  </button>

  <div id="form-message" class="hidden rounded-md p-4" role="status" aria-live="polite"></div>
</form>

<script>
  import { createFormAdapter } from '@/lib/form-adapter';
  import type { FormSubmission } from '@/lib/form-adapter';

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const messageDiv = document.getElementById('form-message') as HTMLDivElement;
  const nameInput = document.getElementById('contact-name') as HTMLInputElement;
  const emailInput = document.getElementById('contact-email') as HTMLInputElement;
  const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement;
  const nameError = document.getElementById('name-error') as HTMLSpanElement;
  const emailError = document.getElementById('email-error') as HTMLSpanElement;
  const messageError = document.getElementById('message-error') as HTMLSpanElement;
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement;

  let lastSubmitTime = 0;
  const THROTTLE_DURATION = 60000;

  function validateField(
    input: HTMLInputElement | HTMLTextAreaElement,
    errorElement: HTMLSpanElement
  ): boolean {
    const value = input.value.trim();
    if (!value) {
      errorElement.textContent = 'This field is required';
      errorElement.classList.remove('hidden');
      input.setAttribute('aria-invalid', 'true');
      return false;
    }
    if (input.type === 'email') {
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(value)) {
        errorElement.textContent = 'Please enter a valid email address';
        errorElement.classList.remove('hidden');
        input.setAttribute('aria-invalid', 'true');
        return false;
      }
    }
    errorElement.classList.add('hidden');
    input.removeAttribute('aria-invalid');
    return true;
  }

  function validateForm(): boolean {
    return (
      validateField(nameInput, nameError) &&
      validateField(emailInput, emailError) &&
      validateField(messageInput, messageError)
    );
  }

  function showMessage(text: string, type: 'success' | 'error') {
    messageDiv.textContent = text;
    messageDiv.className =
      type === 'success'
        ? 'p-4 rounded-md bg-green-100 text-green-800'
        : 'p-4 rounded-md bg-red-100 text-red-800';
    messageDiv.classList.remove('hidden');
    messageDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  async function handleSubmit(e: Event) {
    e.preventDefault();
    messageDiv.classList.add('hidden');

    if (!validateForm()) {
      showMessage('Please fix the errors above', 'error');
      return;
    }

    const now = Date.now();
    if (now - lastSubmitTime < THROTTLE_DURATION) {
      const remaining = Math.ceil((THROTTLE_DURATION - (now - lastSubmitTime)) / 1000);
      showMessage(`Please wait ${remaining} seconds before submitting again`, 'error');
      return;
    }

    const originalText = submitBtn.textContent;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';

    try {
      const adapter = createFormAdapter();
      const data: FormSubmission = {
        name: (document.getElementById('contact-name') as HTMLInputElement).value,
        email: (document.getElementById('contact-email') as HTMLInputElement).value,
        message: (document.getElementById('contact-message') as HTMLTextAreaElement).value,
      };
      const response = await adapter.submit(data);
      if (response.success) {
        lastSubmitTime = now;
        form.reset();
        showMessage('Message sent successfully!', 'success');
      } else {
        showMessage('Failed to send message. Please try again.', 'error');
      }
    } catch {
      showMessage('An unexpected error occurred. Please try again.', 'error');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = originalText || 'Submit';
    }
  }

  form.addEventListener('submit', handleSubmit);
  nameInput.addEventListener('blur', () => validateField(nameInput, nameError));
  emailInput.addEventListener('blur', () => validateField(emailInput, emailError));
  messageInput.addEventListener('blur', () => validateField(messageInput, messageError));

  document.addEventListener('astro:page-load', () => messageDiv.classList.add('hidden'));
</script>
