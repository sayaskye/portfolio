---
import { getTranslation } from '@/i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = (key: string) => getTranslation(key, lang);
---

<form
  id="contact-form"
  class="space-y-4"
  data-msg-success={t('contact.form.success')}
  data-msg-error={t('contact.form.error')}
  data-msg-sending={t('contact.form.sending')}
  data-msg-required={t('contact.form.validation.required')}
  data-msg-invalid-email={t('contact.form.validation.invalidEmail')}
  data-msg-fix-errors={t('contact.form.validation.fixErrors')}
  data-msg-throttle-prefix={t('contact.form.validation.throttlePrefix')}
  data-msg-throttle-suffix={t('contact.form.validation.throttleSuffix')}
  data-msg-unexpected={t('contact.form.validation.unexpected')}
  data-msg-submit={t('contact.form.placeholders.submit')}
  novalidate
>
  <div>
    <label for="contact-name" class="mb-2 block text-sm font-bold text-(--text-primary)">
      {t('contact.form.name')}
    </label>
    <input
      type="text"
      id="contact-name"
      name="name"
      required
      placeholder={t('contact.form.placeholders.name')}
      class="focus:border-primary focus:ring-primary/20 w-full rounded-lg border border-(--border-color) bg-(--bg-secondary) px-4 py-3 text-(--text-primary) transition-all outline-none placeholder:text-(--text-muted) focus:ring-1"
      aria-required="true"
    />
    <span id="name-error" class="mt-1 hidden text-sm text-red-500" role="alert"></span>
  </div>

  <div>
    <label for="contact-email" class="mb-2 block text-sm font-bold text-(--text-primary)">
      {t('contact.form.email')}
    </label>
    <input
      type="email"
      id="contact-email"
      name="email"
      required
      placeholder={t('contact.form.placeholders.email')}
      class="focus:border-primary focus:ring-primary/20 w-full rounded-lg border border-(--border-color) bg-(--bg-secondary) px-4 py-3 text-(--text-primary) transition-all outline-none placeholder:text-(--text-muted) focus:ring-1"
      aria-required="true"
    />
    <span id="email-error" class="mt-1 hidden text-sm text-red-500" role="alert"></span>
  </div>

  <div>
    <label for="contact-subject" class="mb-2 block text-sm font-bold text-(--text-primary)">
      {t('contact.form.subject')}
    </label>
    <input
      type="text"
      id="contact-subject"
      name="subject"
      required
      placeholder={t('contact.form.placeholders.subject')}
      class="focus:border-primary focus:ring-primary/20 w-full rounded-lg border border-(--border-color) bg-(--bg-secondary) px-4 py-3 text-(--text-primary) transition-all outline-none placeholder:text-(--text-muted) focus:ring-1"
      aria-required="true"
    />
    <span id="subject-error" class="mt-1 hidden text-sm text-red-500" role="alert"></span>
  </div>

  <div>
    <label for="contact-message" class="mb-2 block text-sm font-bold text-(--text-primary)">
      {t('contact.form.message')}
    </label>
    <textarea
      id="contact-message"
      name="message"
      rows="4"
      required
      placeholder={t('contact.form.placeholders.message')}
      class="focus:border-primary focus:ring-primary/20 w-full resize-y rounded-lg border border-(--border-color) bg-(--bg-secondary) px-4 py-3 text-(--text-primary) transition-all outline-none placeholder:text-(--text-muted) focus:ring-1"
      aria-required="true"></textarea>
    <span id="message-error" class="mt-1 hidden text-sm text-red-500" role="alert"></span>
  </div>

  <input type="text" name="_gotcha" style="display:none" />

  <button
    type="submit"
    id="contact-submit"
    class="bg-primary text-on-primary w-full cursor-pointer rounded-lg py-4 text-base font-bold transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
  >
    {t('common.actions.submit')}
  </button>

  <div id="form-message" class="hidden rounded-md p-4" role="status" aria-live="polite"></div>
</form>

<script>
  import { createFormAdapter } from '@/lib/form-adapter';
  import type { FormSubmission } from '@/lib/form-adapter';

  function initContactForm(form: HTMLFormElement) {
    const messageDiv = form.querySelector('#form-message') as HTMLDivElement;
    const submitBtn = form.querySelector('#contact-submit') as HTMLButtonElement;

    const inputs = Array.from(
      form.querySelectorAll('input[id^="contact-"], textarea[id^="contact-"]')
    ) as (HTMLInputElement | HTMLTextAreaElement)[];

    const t = form.dataset;
    let lastSubmitTime = 0;
    const THROTTLE_DURATION = 60000;

    const getErrorElement = (input: HTMLElement) =>
      form.querySelector(`#${input.id.replace('contact-', '')}-error`) as HTMLSpanElement;

    const validateField = (input: HTMLInputElement | HTMLTextAreaElement): boolean => {
      const errorElement = getErrorElement(input);
      if (!errorElement) return true;

      if (!input.checkValidity()) {
        errorElement.textContent =
          input.type === 'email' && input.value ? t.msgInvalidEmail || '' : t.msgRequired || '';
        errorElement.classList.remove('hidden');
        input.setAttribute('aria-invalid', 'true');
        return false;
      }
      errorElement.classList.add('hidden');
      input.removeAttribute('aria-invalid');
      return true;
    };

    const showMessage = (text: string, type: 'success' | 'error') => {
      messageDiv.textContent = text;
      messageDiv.className =
        type === 'success'
          ? 'p-4 rounded-md bg-green-100 text-green-800'
          : 'p-4 rounded-md bg-red-100 text-red-800';
      messageDiv.classList.remove('hidden');
      messageDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    };

    const handleSubmit = async (e: Event) => {
      e.preventDefault();
      messageDiv.classList.add('hidden');

      const isFormValid = inputs.every((input) => validateField(input));
      if (!isFormValid) {
        showMessage(t.msgFixErrors || '', 'error');
        return;
      }

      const now = Date.now();
      if (now - lastSubmitTime < THROTTLE_DURATION) {
        const remaining = Math.ceil((THROTTLE_DURATION - (now - lastSubmitTime)) / 1000);
        showMessage(`${t.msgThrottlePrefix} ${remaining} ${t.msgThrottleSuffix}`, 'error');
        return;
      }

      const originalText = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = t.msgSending || '';

      try {
        const adapter = createFormAdapter();
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries()) as unknown as FormSubmission;

        const response = await adapter.submit(data);
        if (response.success) {
          lastSubmitTime = now;
          form.reset();
          showMessage(t.msgSuccess || '', 'success');
        } else {
          showMessage(t.msgError || '', 'error');
        }
      } catch {
        showMessage(t.msgUnexpected || '', 'error');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalText || t.msgSubmit || '';
      }
    };

    form.addEventListener('submit', handleSubmit);
    inputs.forEach((input) => {
      input.addEventListener('blur', () => validateField(input));
      input.addEventListener('input', () => {
        if (input.getAttribute('aria-invalid') === 'true') validateField(input);
      });
    });
  }

  const setup = () => {
    const forms = document.querySelectorAll<HTMLFormElement>('#contact-form');
    forms.forEach(initContactForm);
  };

  setup();
  document.addEventListener('astro:page-load', setup);
</script>
