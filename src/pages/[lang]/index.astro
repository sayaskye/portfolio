---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Hero from '@/components/home/Hero.astro';
import FeaturedProjects from '@/components/home/FeaturedProjects.astro';
import Experience from '@/components/home/Experience.astro';
import About from '@/components/home/About.astro';
import { getTranslation, getSupportedLanguages } from '@/i18n';
import type { SEOMetadata } from '@/lib/seo';
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';

export const getStaticPaths: GetStaticPaths = async () => {
  const languages = getSupportedLanguages();
  return languages.map((lang) => ({
    params: { lang },
  }));
};

const { lang } = Astro.params;
const t = (key: string) => getTranslation(key, lang as string);

// Get featured projects for this language
const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((project) => project.data.language === lang && project.data.featured)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

// Build SEO metadata
const siteUrl = import.meta.env.SITE || 'https://zares.dev';
const supportedLanguages = getSupportedLanguages();
const seo: SEOMetadata = {
  title: t('home.hero.title'),
  description: t('home.hero.subtitle'),
  canonical: `${siteUrl}/${lang}/`,
  lang: lang as string,
  alternateLanguages: supportedLanguages.map((l) => ({
    lang: l,
    url: `${siteUrl}/${l}/`,
  })),
};
---

<BaseLayout seo={seo}>
  <Header lang={lang as string} />

  <main>
    <Hero lang={lang as string} />
    <FeaturedProjects lang={lang as string} projects={featuredProjects} />
    <Experience lang={lang as string} />
    <About lang={lang as string} />
  </main>

  <Footer lang={lang as string} />
</BaseLayout>
