---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import ContactForm from '@/components/forms/ContactForm.astro';
import ContactHero from '@/components/contact/ContactHero.astro';
import ContactInfo from '@/components/contact/ContactInfo.astro';
import { getTranslation, getSupportedLanguages } from '@/i18n';
import type { SEOMetadata } from '@/lib/seo';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const languages = getSupportedLanguages();
  return languages.map((lang) => ({ params: { lang } }));
};

const { lang } = Astro.params;
const t = (key: string) => getTranslation(key, lang as string);

const siteUrl = import.meta.env.SITE || 'https://zares.dev';
const supportedLanguages = getSupportedLanguages();

const seo: SEOMetadata = {
  title: `${t('common.nav.contact')} | Portfolio`,
  description: t('contact.page.seo_description'),
  canonical: `${siteUrl}/${lang}/contact/`,
  lang: lang as string,
  alternateLanguages: supportedLanguages.map((l) => ({
    lang: l,
    url: `${siteUrl}/${l}/contact/`,
  })),
};
---

<BaseLayout seo={seo}>
  <Header lang={lang as string} />

  <main class="mx-auto flex max-w-7xl flex-1 flex-col">
    <section class="flex flex-1 flex-col justify-center py-8 lg:py-24" id="contact">
      <div class="mx-auto w-full px-4 sm:px-6 lg:px-8">
        <ContactHero
          eyebrow={t('common.nav.contact')}
          title={t('contact.page.title')}
          subtitle={t('contact.page.subtitle')}
        />

        <div
          class="relative w-full overflow-hidden rounded-3xl border border-(--border-color) bg-(--bg-secondary) p-5 sm:p-8 lg:flex lg:gap-12 lg:p-16"
        >
          <!-- Background gradient decoration -->
          <div class="pointer-events-none absolute inset-0 opacity-10">
            <svg class="h-full w-full" preserveAspectRatio="none" viewBox="0 0 100 100">
              <defs>
                <linearGradient id="contact-grad" x1="0%" x2="100%" y1="0%" y2="100%">
                  <stop offset="0%" style="stop-color:#79d5e2;stop-opacity:1"></stop>
                  <stop offset="100%" style="stop-color:#3865A1;stop-opacity:1"></stop>
                </linearGradient>
              </defs>
              <path d="M0,0 L100,0 L100,100 Z" fill="url(#contact-grad)"></path>
            </svg>
          </div>

          <ContactInfo lang={lang as string} />

          <div
            class="relative z-10 w-full rounded-2xl border border-(--border-subtle) bg-(--bg-elevated) p-6 shadow-xl sm:p-8 lg:w-1/2"
          >
            <ContactForm lang={lang as string} />
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang as string} />
</BaseLayout>
