---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import ContactForm from '@/components/forms/ContactForm.astro';
import { getTranslation, getSupportedLanguages } from '@/i18n';
import type { SEOMetadata } from '@/lib/seo';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const languages = getSupportedLanguages();
  return languages.map((lang) => ({ params: { lang } }));
};

const { lang } = Astro.params;
const t = (key: string) => getTranslation(key, lang as string);

const siteUrl = import.meta.env.SITE || 'https://zares.dev';
const supportedLanguages = getSupportedLanguages();

const seo: SEOMetadata = {
  title: `${t('common.nav.contact')} - Portfolio`,
  description: 'Get in touch for architectural consultation or project collaboration.',
  canonical: `${siteUrl}/${lang}/contact/`,
  lang: lang as string,
  alternateLanguages: supportedLanguages.map((l) => ({
    lang: l,
    url: `${siteUrl}/${l}/contact/`,
  })),
};
---

<BaseLayout seo={seo}>
  <Header lang={lang as string} />

  <main class="flex-1 flex flex-col">
    <section class="flex-1 flex flex-col justify-center py-16 lg:py-24" id="contact">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <!-- Section header -->
        <div class="mb-12 text-center">
          <h2 class="text-primary mb-2 text-base font-bold tracking-widest uppercase">
            {t('common.nav.contact')}
          </h2>
          <h1 class="mb-4 text-4xl font-bold lg:text-5xl">{t('contact.page.title')}</h1>
          <p class="mx-auto max-w-2xl text-lg text-(--text-secondary)">
            {t('contact.page.subtitle')}
          </p>
        </div>

        <!-- Contact card -->
        <div
          class="relative overflow-hidden rounded-3xl bg-(--bg-secondary) p-8 lg:flex lg:gap-12 lg:p-16 border border-(--border-color)"
        >
          <!-- Background gradient decoration -->
          <div class="pointer-events-none absolute inset-0 opacity-10">
            <svg class="h-full w-full" preserveAspectRatio="none" viewBox="0 0 100 100">
              <defs>
                <linearGradient id="contact-grad" x1="0%" x2="100%" y1="0%" y2="100%">
                  <stop offset="0%" style="stop-color:#79d5e2;stop-opacity:1"></stop>
                  <stop offset="100%" style="stop-color:#3865A1;stop-opacity:1"></stop>
                </linearGradient>
              </defs>
              <path d="M0,0 L100,0 L100,100 Z" fill="url(#contact-grad)"></path>
            </svg>
          </div>

          <!-- Left: Contact info -->
          <div class="relative z-10 mb-10 lg:mb-0 lg:w-1/2">
            <h3 class="mb-4 text-3xl font-bold text-(--text-primary)">{t('contact.page.card_title')}</h3>
            <p class="mb-8 text-lg text-(--text-secondary)">
              {t('contact.page.card_subtitle')}
            </p>

            <div class="space-y-6">
              <a
                class="flex items-center gap-4 text-(--text-primary) transition-colors hover:text-primary"
                href="mailto:hello@zares.dev"
              >
                <div
                  class="flex h-12 w-12 items-center justify-center rounded-full border border-(--border-color) bg-(--bg-primary) text-primary"
                >
                  <span class="material-symbols-outlined">mail</span>
                </div>
                <div>
                  <p class="text-xs font-bold tracking-widest text-(--text-muted) uppercase">{t('contact.page.email_label')}</p>
                  <p class="font-medium text-(--text-primary)">hello@zares.dev</p>
                </div>
              </a>

              <div class="flex items-center gap-4 text-(--text-primary)">
                <div
                  class="flex h-12 w-12 items-center justify-center rounded-full border border-(--border-color) bg-(--bg-primary) text-primary"
                >
                  <span class="material-symbols-outlined">location_on</span>
                </div>
                <div>
                  <p class="text-xs font-bold tracking-widest text-(--text-muted) uppercase">
                    {t('contact.page.location_label')}
                  </p>
                  <p class="font-medium text-(--text-primary)">{t('contact.page.location_value')}</p>
                </div>
              </div>
            </div>

            <div class="mt-12 flex gap-4">
              <a
                class="flex h-12 w-12 items-center justify-center rounded-xl bg-(--bg-primary) border border-(--border-color) text-(--text-primary) transition-all hover:bg-primary hover:text-on-primary hover:-translate-y-1 shadow-sm"
                href="#"
                aria-label="GitHub"
              >
                <svg class="h-6 w-6 fill-current" viewBox="0 0 24 24">
                  <path
                    d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.041-1.416-4.041-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                  ></path>
                </svg>
              </a>
              <a
                class="flex h-12 w-12 items-center justify-center rounded-xl bg-(--bg-primary) border border-(--border-color) text-(--text-primary) transition-all hover:bg-primary hover:text-on-primary hover:-translate-y-1 shadow-sm"
                href="#"
                aria-label="LinkedIn"
              >
                <svg class="h-6 w-6 fill-current" viewBox="0 0 24 24">
                  <path
                    d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
                  ></path>
                </svg>
              </a>
            </div>
          </div>

          <!-- Right: Form -->
          <div class="relative z-10 rounded-2xl bg-(--bg-elevated) p-8 shadow-xl lg:w-1/2 border border-(--border-subtle)">
            <ContactForm lang={lang as string} />
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang as string} />
</BaseLayout>
