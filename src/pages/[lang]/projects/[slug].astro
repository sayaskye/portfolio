---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { getTranslation, getSupportedLanguages } from '@/i18n';
import { getCollection } from 'astro:content';
import type { SEOMetadata } from '@/lib/seo';
import Icon from '@/components/ui/Icon.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects.map((project) => {
    const slug = project.slug.replace(`${project.data.language}/`, '');

    // Find all translations for this project to create mapping
    const translations = projects.filter((p) => p.data.id === project.data.id);
    const langUrls: Record<string, string> = {};
    translations.forEach((t) => {
      const tSlug = t.slug.replace(`${t.data.language}/`, '');
      langUrls[t.data.language] = `/${t.data.language}/projects/${tSlug}/`;
    });

    return {
      params: {
        lang: project.data.language,
        slug,
      },
      props: { project, langUrls },
    };
  });
}

const { project, langUrls } = Astro.props;
const { lang } = Astro.params;
const t = (key: string) => getTranslation(key, lang as string);

const { Content } = await project.render();

// Build SEO metadata
const siteUrl = import.meta.env.SITE || 'https://zares.dev';
const supportedLanguages = getSupportedLanguages();

const seo: SEOMetadata = {
  title: `${project.data.title} - ${t('common.nav.projects')}`,
  description: project.data.description,
  canonical: `${siteUrl}${langUrls[lang as string]}`,
  lang: lang as string,
  ogImage: project.data.image?.src,
  alternateLanguages: supportedLanguages.map((l) => ({
    lang: l,
    url: `${siteUrl}${langUrls[l] || `/${l}/projects/`}`,
  })),
};
---

<BaseLayout seo={seo}>
  <Header lang={lang as string} langUrls={langUrls} />

  <main class="mx-auto max-w-7xl px-4 py-12">
    <!-- Breadcrumbs -->
    <nav
      class="mb-8 flex items-center gap-2 text-sm text-(--text-secondary) transition-colors duration-300"
    >
      <a class="hover:text-primary transition-all duration-300" href={`/${lang}/projects/`}>
        {t('common.nav.projects') || 'Portfolio'}
      </a>
      <Icon name="chevron_right" class="size-3" />
      <span class="font-medium text-(--text-primary) transition-colors duration-300"
        >{project.data.title}</span
      >
    </nav>

    <!-- Project Hero Section -->
    <section class="mb-16">
      <div class="mb-8 flex flex-col items-start justify-between gap-6 md:flex-row">
        <div class="max-w-auto">
          <h1
            class="mb-4 text-4xl font-black tracking-tighter transition-colors duration-300 md:text-6xl"
            transition:name={`project-title-${project.data.id}`}
          >
            {project.data.title}
          </h1>
          <p class="text-xl leading-relaxed text-(--text-secondary) transition-colors duration-300">
            {project.data.description}
          </p>
        </div>
        <div class="flex w-full flex-wrap items-end justify-end gap-4 md:w-auto">
          {
            project.data.demo && (
              <a
                href={project.data.demo}
                target="_blank"
                rel="noopener noreferrer"
                class="bg-primary text-on-primary hover:bg-primary/90 shadow-primary/20 flex w-40 items-center gap-2 rounded-xl px-6 py-3 font-bold shadow-lg transition-all"
              >
                <Icon name="open_in_new" class="size-5" />
                {t('projects.page.live_demo')}
              </a>
            )
          }
        </div>
      </div>
      <div
        class="group relative flex aspect-video items-center justify-center overflow-hidden rounded-2xl border border-(--border-color) bg-(--bg-secondary) transition-colors duration-300"
      >
        {
          project.data.image ? (
            <img
              class="absolute inset-0 h-full w-full object-cover opacity-80"
              alt={project.data.image.alt}
              src={project.data.image.src}
              transition:name={`project-image-${project.data.id}`}
            />
          ) : null
        }
      </div>
    </section>

    <!-- Technical Metadata Grid -->
    <section
      class="mb-16 grid grid-cols-2 gap-6 border-y border-(--border-color) py-8 transition-colors duration-300 md:grid-cols-4"
    >
      <div class="col-span-2">
        <h4 class="text-primary mb-1 text-xs font-bold tracking-widest uppercase">
          {t('projects.page.tags')}
        </h4>
        <p class="flex flex-wrap gap-1 leading-tight font-medium">{project.data.tags.join(', ')}</p>
      </div>
      <div>
        <h4 class="text-primary mb-1 text-xs font-bold tracking-widest uppercase">
          {t('projects.page.date')}
        </h4>
        <p class="font-medium">
          {
            project.data.publishDate.toLocaleDateString(lang as string, {
              year: 'numeric',
              month: 'short',
            })
          }
        </p>
      </div>
      <div>
        <h4 class="text-primary mb-1 text-xs font-bold tracking-widest uppercase">
          {t('projects.page.links')}
        </h4>
        {
          project.data.github && (
            <a
              href={project.data.github}
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary block font-medium hover:underline"
            >
              {t('projects.page.source')}
            </a>
          )
        }
      </div>
    </section>

    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
      <!-- Article Body -->
      <div class="prose max-w-none lg:col-span-8">
        <Content />
      </div>

      <!-- Sticky Sidebar -->
      <aside class="lg:col-span-4">
        <div class="sticky top-24 space-y-8">
          <div
            class="bg-primary/5 border-primary/20 rounded-2xl border p-6 transition-colors duration-300"
          >
            <h3
              class="mb-4 flex items-center gap-2 text-lg font-bold transition-colors duration-300"
            >
              <Icon name="code" class="text-primary size-5" /> Technologies
            </h3>
            <div class="flex flex-wrap gap-2">
              {
                project.data.tags.map((tag) => (
                  <span class="rounded-full border border-(--border-color) bg-(--bg-primary) px-3 py-1 text-xs font-semibold transition-colors duration-300">
                    {tag}
                  </span>
                ))
              }
            </div>
          </div>
        </div>
      </aside>
    </div>
  </main>

  <Footer lang={lang as string} />
</BaseLayout>
