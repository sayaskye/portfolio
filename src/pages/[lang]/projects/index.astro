---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import FeaturedProjectHero from '@/components/projects/FeaturedProjectHero.astro';
import ProjectGridCard from '@/components/projects/ProjectGridCard.astro';
import Icon from '@/components/ui/Icon.astro';
import { getTranslation, getSupportedLanguages } from '@/i18n';
import { getCollection } from 'astro:content';
import type { SEOMetadata } from '@/lib/seo';

export async function getStaticPaths() {
  const supportedLanguages = getSupportedLanguages();
  return supportedLanguages.map((lang) => ({
    params: { lang },
  }));
}

const lang = Astro.params.lang as string;
const t = (key: string) => getTranslation(key, lang);

// Fetch projects for the current language
const projects = await getCollection('projects', (entry) => {
  return entry.data.language === lang;
});

// Sort by publishDate (newest first)
const sortedProjects = projects.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

// Get unique categories for filtering, skip missing ones
const categories = [...new Set(sortedProjects.map((p) => p.data.category).filter(Boolean))];

const siteUrl = import.meta.env.SITE || 'https://zares.dev';
const supportedLanguages = getSupportedLanguages();

// Map normalized category keys to translation keys
const categoryLabels: Record<string, string> = {
  distributed: 'projects.page.filter_distributed',
  cloud: 'projects.page.filter_cloud',
  frontend: 'projects.page.filter_frontend',
  data: 'projects.page.filter_data',
};

const seo: SEOMetadata = {
  title: t('common.nav.projects'),
  description: t('projects.page.seo_description'),
  canonical: `${siteUrl}/${lang}/projects/`,
  lang,
  alternateLanguages: supportedLanguages.map((l) => ({
    lang: l,
    url: `${siteUrl}/${l}/projects/`,
  })),
};
---

<BaseLayout seo={seo}>
  <Header lang={lang} />

  <main class="mx-auto max-w-7xl flex-1 px-2 py-8 sm:px-6 lg:px-8">
    <!-- Breadcrumbs & Title -->
    <div class="mb-8 flex flex-col gap-2">
      <div class="flex items-center gap-2 text-sm text-(--text-secondary)">
        <a class="hover:text-primary transition-colors" href={`/${lang}/`}>{t('common.nav.home')}</a
        >
        <Icon name="chevron_right" class="size-3" />
        <span class="text-primary font-medium">{t('common.nav.projects')}</span>
      </div>
      <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
        <div class="max-w-2xl">
          <h1 class="text-4xl leading-tight font-black tracking-tight text-(--text-primary)">
            {t('projects.page.title')}
          </h1>
          <p class="mt-2 text-lg text-(--text-secondary)">
            {t('projects.page.subtitle')}
          </p>
        </div>
      </div>
    </div>

    <!-- Filters -->
    <div
      class="no-scrollbar mb-10 flex flex-wrap items-center justify-center gap-3 overflow-x-auto border-b border-(--border-color) pb-8"
      id="filter-container"
    >
      <button
        data-filter="all"
        class="filter-btn bg-primary text-on-primary flex h-10 shrink-0 cursor-pointer items-center justify-center gap-x-2 rounded-full px-6 text-sm font-bold transition-all"
      >
        {t('projects.page.all')}
      </button>
      {
        categories.map((cat) => (
          <button
            data-filter={cat}
            class="filter-btn hover:border-primary flex h-10 shrink-0 cursor-pointer items-center justify-center gap-x-2 rounded-full border border-(--border-color) bg-(--bg-secondary) px-5 text-sm font-medium text-(--text-secondary) transition-all"
          >
            {t(categoryLabels[cat.toLowerCase()] || `projects.page.filter_${cat.toLowerCase()}`)}
          </button>
        ))
      }
    </div>

    <!-- Featured Highlight Section -->
    <div id="featured-section">
      {
        sortedProjects
          .filter((p) => p.data.featured)
          .slice(0, 1)
          .map((featuredProject) => <FeaturedProjectHero project={featuredProject} lang={lang} />)
      }
    </div>

    <!-- Projects Grid -->
    {
      sortedProjects.length > 0 ? (
        <div id="projects-grid" class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {sortedProjects.map((project) => (
            <ProjectGridCard project={project} lang={lang} />
          ))}
        </div>
      ) : (
        <div class="rounded-lg border border-dashed border-(--border-color) py-12 text-center text-(--text-secondary)">
          {t('home.featured_projects.empty')}
        </div>
      )
    }
  </main>

  <script>
    function setupFilters() {
      const filterBtns = document.querySelectorAll('.filter-btn');
      const projectCards = document.querySelectorAll('.project-card');
      const featuredSection = document.getElementById('featured-section');

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-filter');

          // Update buttons UI
          filterBtns.forEach((b) => {
            b.classList.remove('bg-primary', 'text-on-primary', 'font-bold');
            b.classList.add(
              'bg-(--bg-secondary)',
              'text-(--text-secondary)',
              'font-medium',
              'border',
              'border-(--border-color)'
            );
          });
          btn.classList.add('bg-primary', 'text-on-primary', 'font-bold');
          btn.classList.remove(
            'bg-(--bg-secondary)',
            'text-(--text-secondary)',
            'font-medium',
            'border',
            'border-(--border-color)'
          );

          // Filter projects
          projectCards.forEach((card) => {
            const category = card.getAttribute('data-category')?.toLowerCase();
            const activeFilter = filter?.toLowerCase();
            if (activeFilter === 'all' || category === activeFilter) {
              (card as HTMLElement).style.display = 'flex';
            } else {
              (card as HTMLElement).style.display = 'none';
            }
          });

          // Show/Hide featured section only on 'all'
          if (featuredSection) {
            featuredSection.style.display = filter === 'all' ? 'block' : 'none';
          }
        });
      });
    }

    // Initial setup
    setupFilters();
    // Re-run on View Transitions
    document.addEventListener('astro:page-load', setupFilters);
  </script>

  <Footer lang={lang} />
</BaseLayout>
