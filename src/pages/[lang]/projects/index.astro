---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { getTranslation, getSupportedLanguages } from '@/i18n';
import { getCollection } from 'astro:content';
import type { SEOMetadata } from '@/lib/seo';

export async function getStaticPaths() {
  const supportedLanguages = getSupportedLanguages();
  return supportedLanguages.map((lang) => ({
    params: { lang },
  }));
}

const lang = Astro.params.lang as string;
const t = (key: string) => getTranslation(key, lang);

// Fetch projects for the current language
const projects = await getCollection('projects', (entry) => {
  return entry.data.language === lang;
});

// Sort by publishDate (newest first)
const sortedProjects = projects.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const siteUrl = import.meta.env.SITE || 'https://zares.dev';
const supportedLanguages = getSupportedLanguages();

const seo: SEOMetadata = {
  title: t('common.nav.projects') || 'Projects',
  description: 'A showcase of my latest projects and work.',
  canonical: `${siteUrl}/${lang}/projects/`,
  lang,
  alternateLanguages: supportedLanguages.map((l) => ({
    lang: l,
    url: `${siteUrl}/${l}/projects/`,
  })),
};
---

<BaseLayout seo={seo}>
  <Header lang={lang} />

  <main class="container mx-auto px-4 py-8">
    <div class="mb-8 flex items-center justify-between">
      <h1 class="text-4xl font-bold md:text-5xl">{t('common.nav.projects') || 'Projects'}</h1>
    </div>

    {
      sortedProjects.length > 0 ? (
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {sortedProjects.map((project) => (
            <article class="bg-(--bg-secondary) flex h-full flex-col overflow-hidden rounded-lg shadow-lg transition-transform hover:-translate-y-1">
              {project.data.image && (
                <div class="aspect-video w-full overflow-hidden">
                  <img
                    src={project.data.image.src}
                    alt={project.data.image.alt}
                    class="h-full w-full object-cover transition-transform duration-300 hover:scale-105"
                  />
                </div>
              )}
              <div class="flex flex-1 flex-col p-6">
                <div class="mb-4 flex flex-wrap gap-2">
                  {project.data.tags.map((tag) => (
                    <span class="rounded-full bg-(--bg-primary) px-2 py-1 text-xs">{tag}</span>
                  ))}
                </div>
                <h3 class="mb-2 text-xl font-bold text-(--text-primary)">
                  <a href={`/${lang}/projects/${project.slug.replace(`${lang}/`, '')}/`} class="hover:text-primary-500 transition-colors">
                    {project.data.title}
                  </a>
                </h3>
                <p class="mb-4 flex-1 text-(--text-secondary)">{project.data.description}</p>
                <div class="mt-auto">
                    <div class="flex gap-4">
                        {project.data.github && (
                            <a href={project.data.github} target="_blank" rel="noopener noreferrer" class="text-sm font-medium hover:text-primary-500 transition-colors">GitHub</a>
                        )}
                        {project.data.demo && (
                            <a href={project.data.demo} target="_blank" rel="noopener noreferrer" class="text-sm font-medium hover:text-primary-500 transition-colors">Demo</a>
                        )}
                    </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="rounded-lg border border-dashed border-(--border-color) py-12 text-center text-(--text-secondary)">
          No projects found for this language.
        </div>
      )
    }
  </main>

  <Footer lang={lang} />
</BaseLayout>
