---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import FeaturedProjectHero from '@/components/projects/FeaturedProjectHero.astro';
import ProjectGridCard from '@/components/projects/ProjectGridCard.astro';
import { getTranslation, getSupportedLanguages } from '@/i18n';
import { getCollection } from 'astro:content';
import type { SEOMetadata } from '@/lib/seo';

export async function getStaticPaths() {
  const supportedLanguages = getSupportedLanguages();
  return supportedLanguages.map((lang) => ({
    params: { lang },
  }));
}

const lang = Astro.params.lang as string;
const t = (key: string) => getTranslation(key, lang);

// Fetch projects for the current language
const projects = await getCollection('projects', (entry) => {
  return entry.data.language === lang;
});

// Sort by publishDate (newest first)
const sortedProjects = projects.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const siteUrl = import.meta.env.SITE || 'https://zares.dev';
const supportedLanguages = getSupportedLanguages();

const seo: SEOMetadata = {
  title: t('common.nav.projects'),
  description: t('projects.page.seo_description'),
  canonical: `${siteUrl}/${lang}/projects/`,
  lang,
  alternateLanguages: supportedLanguages.map((l) => ({
    lang: l,
    url: `${siteUrl}/${l}/projects/`,
  })),
};
---

<BaseLayout seo={seo}>
  <Header lang={lang} />

  <main class="mx-auto max-w-7xl flex-1 px-2 py-8 sm:px-6 lg:px-8">
    <!-- Breadcrumbs & Title -->
    <div class="mb-8 flex flex-col gap-2">
      <div class="flex items-center gap-2 text-sm text-(--text-secondary)">
        <a class="hover:text-primary transition-colors" href={`/${lang}/`}>{t('common.nav.home')}</a
        >
        <span class="material-symbols-outlined text-xs">chevron_right</span>
        <span class="text-primary font-medium">{t('common.nav.projects')}</span>
      </div>
      <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
        <div class="max-w-2xl">
          <h1 class="text-4xl leading-tight font-black tracking-tight text-(--text-primary)">
            {t('projects.page.title')}
          </h1>
          <p class="mt-2 text-lg text-(--text-secondary)">
            {t('projects.page.subtitle')}
          </p>
        </div>
        <div class="flex gap-2">
          <div class="flex rounded-lg border border-(--border-color) bg-(--bg-secondary) p-1">
            <button class="text-primary cursor-pointer rounded bg-(--bg-primary) p-2 shadow-sm">
              <span class="material-symbols-outlined">grid_view</span>
            </button>
            <button
              class="cursor-pointer p-2 text-(--text-secondary) hover:text-(--text-secondary)"
            >
              <span class="material-symbols-outlined">view_list</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Filters -->
    <div
      class="no-scrollbar mb-10 flex gap-3 overflow-x-auto border-b border-(--border-color) pb-8"
    >
      <button
        class="bg-primary text-on-primary flex h-10 shrink-0 cursor-pointer items-center justify-center gap-x-2 rounded-full px-6 text-sm font-bold"
      >
        {t('projects.page.all')}
      </button>
      <button
        class="hover:border-primary flex h-10 shrink-0 cursor-pointer items-center justify-center gap-x-2 rounded-full border border-(--border-color) bg-(--bg-secondary) px-5 text-sm font-medium text-(--text-secondary) transition-colors"
      >
        {t('projects.page.filter_distributed')}
      </button>
      <button
        class="hover:border-primary flex h-10 shrink-0 cursor-pointer items-center justify-center gap-x-2 rounded-full border border-(--border-color) bg-(--bg-secondary) px-5 text-sm font-medium text-(--text-secondary) transition-colors"
      >
        {t('projects.page.filter_cloud')}
      </button>
    </div>

    <!-- Featured Highlight Section -->
    {
      sortedProjects
        .filter((p) => p.data.featured)
        .slice(0, 1)
        .map((featuredProject) => <FeaturedProjectHero project={featuredProject} lang={lang} />)
    }

    <!-- Projects Grid -->
    {
      sortedProjects.length > 0 ? (
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {sortedProjects.map((project) => (
            <ProjectGridCard project={project} lang={lang} />
          ))}
        </div>
      ) : (
        <div class="rounded-lg border border-dashed border-(--border-color) py-12 text-center text-(--text-secondary)">
          {t('home.featured_projects.empty')}
        </div>
      )
    }
  </main>

  <Footer lang={lang} />
</BaseLayout>
