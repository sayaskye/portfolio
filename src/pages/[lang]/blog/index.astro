---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { getTranslation, getSupportedLanguages } from '@/i18n';
import { getCollection } from 'astro:content';
import type { SEOMetadata } from '@/lib/seo';

export async function getStaticPaths() {
  const supportedLanguages = getSupportedLanguages();
  return supportedLanguages.map((lang) => ({
    params: { lang },
  }));
}

const lang = Astro.params.lang as string;
const t = (key: string) => getTranslation(key, lang);

// Fetch blog posts for the current language
const blogs = await getCollection('blog', (entry) => {
  return entry.data.language === lang;
});

// Sort by publishDate (newest first)
const sortedBlogs = blogs.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const siteUrl = import.meta.env.SITE || 'https://zares.dev';
const supportedLanguages = getSupportedLanguages();

const seo: SEOMetadata = {
  title: t('common.nav.blog') || 'Blog',
  description: 'Blog posts and articles',
  canonical: `${siteUrl}/${lang}/blog/`,
  lang,
  alternateLanguages: supportedLanguages.map((l) => ({
    lang: l,
    url: `${siteUrl}/${l}/blog/`,
  })),
};
---

<BaseLayout seo={seo}>
  <Header lang={lang} />

  <main class="container mx-auto px-4 py-8">
    <div class="mb-8 flex items-center justify-between">
      <h1 class="text-4xl font-bold md:text-5xl">{t('common.nav.blog') || 'Blog'}</h1>
    </div>

    {
      sortedBlogs.length > 0 ? (
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {sortedBlogs.map((blog) => (
            <article class="bg-(--bg-secondary) flex h-full flex-col overflow-hidden rounded-lg shadow-lg transition-transform hover:-translate-y-1">
              {blog.data.image && (
                <div class="aspect-video w-full overflow-hidden">
                  <img
                    src={blog.data.image.src}
                    alt={blog.data.image.alt}
                    class="h-full w-full object-cover transition-transform duration-300 hover:scale-105"
                  />
                </div>
              )}
              <div class="flex flex-1 flex-col p-6">
                <div class="mb-4 flex flex-wrap gap-2">
                  {blog.data.tags.map((tag) => (
                    <span class="rounded-full bg-(--bg-primary) px-2 py-1 text-xs">{tag}</span>
                  ))}
                </div>
                <h3 class="mb-2 text-xl font-bold text-(--text-primary)">
                  <a href={`/${lang}/blog/${blog.slug.replace(`${lang}/`, '')}/`} class="hover:text-primary-500 transition-colors">
                    {blog.data.title}
                  </a>
                </h3>
                <p class="mb-4 flex-1 text-(--text-secondary)">{blog.data.description}</p>
                <div class="mt-auto">
                  <time datetime={blog.data.publishDate.toISOString()} class="text-sm text-(--text-secondary)">
                    {blog.data.publishDate.toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="rounded-lg border border-dashed border-(--border-color) py-12 text-center text-(--text-secondary)">
          No blog posts found for this language.
        </div>
      )
    }
  </main>

  <Footer lang={lang} />
</BaseLayout>
