---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import BlogCard from '@/components/blog/BlogCard.astro';
import Icon from '@/components/ui/Icon.astro';
import { getTranslation, getSupportedLanguages } from '@/i18n';
import { getCollection } from 'astro:content';
import type { SEOMetadata } from '@/lib/seo';

export async function getStaticPaths() {
  const supportedLanguages = getSupportedLanguages();
  return supportedLanguages.map((lang) => ({
    params: { lang },
  }));
}

const lang = Astro.params.lang as string;
const t = (key: string) => getTranslation(key, lang);

// Fetch blog posts for the current language
const blogs = await getCollection('blog', (entry) => {
  return entry.data.language === lang;
});

// Sort by publishDate (newest first)
const sortedBlogs = blogs.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

// Get unique categories for filtering, skipping undefined
const categories = [...new Set(sortedBlogs.map((b) => b.data.category).filter(Boolean))];

const siteUrl = import.meta.env.SITE || 'https://zares.dev';
const supportedLanguages = getSupportedLanguages();

// Categories are now standard: frontend, backend, mobile, fullstack, architecture, design

const seo: SEOMetadata = {
  title: t('common.nav.blog'),
  description: t('blog.page.seo_description'),
  canonical: `${siteUrl}/${lang}/blog/`,
  lang,
  alternateLanguages: supportedLanguages.map((l) => ({
    lang: l,
    url: `${siteUrl}/${l}/blog/`,
  })),
};
---

<BaseLayout seo={seo}>
  <Header lang={lang} />

  <main class="mx-auto w-full max-w-7xl flex-1 px-2 py-8 sm:px-6 lg:px-8">
    <!-- Breadcrumbs & Title -->
    <div class="mb-10 flex flex-col gap-2">
      <div class="flex items-center gap-2 text-sm text-(--text-secondary)">
        <a class="hover:text-primary transition-colors duration-300" href={`/${lang}/`}
          >{t('common.nav.home')}</a
        >
        <Icon name="chevron_right" class="size-3" />
        <span class="text-primary font-medium">{t('common.nav.blog')}</span>
      </div>
      <div class="flex flex-col">
        <h1 class="text-4xl leading-tight font-black tracking-tight text-(--text-primary)">
          {t('blog.page.title')}
        </h1>
        <p class="mt-2 text-lg text-(--text-secondary)">
          {t('blog.page.subtitle')}
        </p>
      </div>
    </div>

    <!-- Categories Filter -->
    <div
      class="no-scrollbar mb-10 flex flex-wrap items-center justify-center gap-3 overflow-x-auto border-b border-(--border-color) pb-8 md:justify-start"
      id="filter-container"
    >
      <button
        data-filter="all"
        class="filter-btn bg-primary text-on-primary shadow-primary/10 flex h-10 shrink-0 cursor-pointer items-center justify-center rounded-full px-5 text-sm font-bold shadow-lg transition-all duration-300"
      >
        {t('blog.page.all_posts')}
      </button>
      {
        categories.map((cat) => (
          <button
            data-filter={cat}
            class="filter-btn hover:border-primary flex h-10 shrink-0 cursor-pointer items-center justify-center rounded-full bg-(--bg-secondary) px-5 text-sm font-medium text-(--text-secondary) transition-all duration-300"
          >
            {t(`common.categories.${cat.toLowerCase()}`)}
          </button>
        ))
      }
    </div>

    <!-- Blog Posts List -->
    <div class="flex flex-col gap-16" id="blog-grid">
      {
        sortedBlogs.length > 0 ? (
          sortedBlogs.map((blog, idx) => <BlogCard blog={blog} lang={lang} isFirst={idx === 0} />)
        ) : (
          <div class="rounded-lg border border-dashed border-(--border-color) py-12 text-center text-(--text-secondary)">
            {t('blog.page.empty')}
          </div>
        )
      }
    </div>
  </main>

  <script>
    function setupFilters() {
      const filterBtns = document.querySelectorAll('.filter-btn');
      const blogCards = document.querySelectorAll('.blog-card');

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-filter');

          // Update buttons UI
          filterBtns.forEach((b) => {
            b.classList.remove('bg-primary', 'text-on-primary', 'shadow-lg', 'font-bold');
            b.classList.add('bg-(--bg-secondary)', 'text-(--text-secondary)', 'font-medium');
          });
          btn.classList.add('bg-primary', 'text-on-primary', 'shadow-lg', 'font-bold');
          btn.classList.remove('bg-(--bg-secondary)', 'text-(--text-secondary)', 'font-medium');

          // Filter blogs
          let firstVisible = true;
          blogCards.forEach((card) => {
            const category = card.getAttribute('data-category')?.toLowerCase();
            const activeFilter = filter?.toLowerCase();
            const htmlCard = card as HTMLElement;
            if (activeFilter === 'all' || category === activeFilter) {
              htmlCard.style.display = 'grid';
              if (firstVisible) {
                htmlCard.classList.remove('border-t', 'border-(--border-color)', 'pt-16');
                firstVisible = false;
              } else {
                htmlCard.classList.add('border-t', 'border-(--border-color)', 'pt-16');
              }
            } else {
              htmlCard.style.display = 'none';
            }
          });
        });
      });
    }

    // Initialize on every page load (first load and View Transition navigations)
    document.addEventListener('astro:page-load', setupFilters);
  </script>

  <Footer lang={lang} />
</BaseLayout>
