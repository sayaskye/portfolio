---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { getTranslation, getSupportedLanguages } from '@/i18n';
import { getCollection } from 'astro:content';
import Icon from '@/components/ui/Icon.astro';
import type { SEOMetadata } from '@/lib/seo';

export async function getStaticPaths() {
  const blogs = await getCollection('blog');

  return blogs.map((blog) => {
    const slug = blog.slug.replace(`${blog.data.language}/`, '');

    // Find all translations for this post to create mapping
    const translations = blogs.filter((b) => b.data.id === blog.data.id);
    const langUrls: Record<string, string> = {};
    translations.forEach((t) => {
      const tSlug = t.slug.replace(`${t.data.language}/`, '');
      langUrls[t.data.language] = `/${t.data.language}/blog/${tSlug}/`;
    });

    return {
      params: {
        lang: blog.data.language,
        slug,
      },
      props: { blog, langUrls },
    };
  });
}

const { blog, langUrls } = Astro.props;
const lang = Astro.params.lang as string;
const t = (key: string) => getTranslation(key, lang);

const { Content } = await blog.render();

// Build SEO metadata
const siteUrl = import.meta.env.SITE || 'https://zares.dev';
const supportedLanguages = getSupportedLanguages();

const seo: SEOMetadata = {
  title: `${blog.data.title} - ${t('common.nav.blog') || 'Blog'}`,
  description: blog.data.description,
  canonical: `${siteUrl}${langUrls[lang]}`,
  lang,
  ogImage: blog.data.image?.src,
  alternateLanguages: supportedLanguages.map((l) => ({
    lang: l,
    url: `${siteUrl}${langUrls[l] || `/${l}/blog/`}`,
  })),
};
---

<BaseLayout seo={seo}>
  <Header lang={lang} langUrls={langUrls} />

  <main class="mx-auto w-full max-w-7xl flex-1 px-6 py-12">
    <!-- Breadcrumbs -->
    <nav
      class="mb-8 flex items-center gap-2 text-sm text-(--text-secondary) transition-colors duration-300"
    >
      <a class="hover:text-primary transition-all duration-300" href={`/${lang}/blog/`}>
        {t('common.nav.blog') || 'Blog'}
      </a>
      <Icon name="chevron_right" class="size-3" />
      <span class="font-medium text-(--text-primary) transition-colors duration-300"
        >{blog.data.title}</span
      >
    </nav>
    <h1
      class="font-display mb-8 text-4xl leading-tight font-bold tracking-tight text-(--text-primary) transition-colors duration-300 md:text-5xl"
      transition:name={`blog-title-${blog.data.id}`}
    >
      {blog.data.title}
    </h1>
    <div
      class="mb-10 flex items-center gap-4 border-b border-(--border-color) pb-10 transition-colors duration-300"
    >
      <div class="flex flex-col">
        <p
          class="mb-1 text-lg leading-none font-bold text-(--text-primary) transition-colors duration-300"
        >
          {t('blog.detail.author')}
        </p>
        <p class="text-sm text-(--text-secondary) transition-colors duration-300">
          <time datetime={blog.data.publishDate.toISOString()}>
            {
              blog.data.publishDate.toLocaleDateString(lang, {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })
            }
          </time>
        </p>
      </div>
    </div>
    <!-- Content Grid -->
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
      <!-- Article Text -->
      <div class="lg:col-span-8">
        {
          blog.data.image && (
            <div class="mb-10 overflow-hidden rounded-xl border border-(--border-color) shadow-lg transition-colors duration-300">
              <img
                src={blog.data.image.src}
                alt={blog.data.image.alt}
                class="w-full object-cover"
                transition:name={`blog-image-${blog.data.id}`}
              />
            </div>
          )
        }
        <p
          class="mb-12 text-xl leading-relaxed font-light text-(--text-secondary) italic transition-colors duration-300"
        >
          {blog.data.description}
        </p>

        <article class="prose max-w-none">
          <Content />
        </article>
      </div>
      <!-- Sidebar -->
      <aside class="space-y-8 lg:col-span-4">
        <!-- Tags/Topics -->
        <div class="sticky top-24">
          <div
            class="rounded-xl border border-(--border-color) bg-(--bg-secondary) p-6 transition-colors duration-300"
          >
            <h4
              class="mb-4 text-sm font-bold tracking-widest text-(--text-secondary) uppercase transition-colors duration-300"
            >
              {t('blog.detail.topics')}
            </h4>
            <div class="flex flex-wrap gap-2">
              {
                blog.data.tags.map((tag) => (
                  <span class="bg-primary/10 text-primary border-primary/20 rounded border px-3 py-1 text-xs font-bold uppercase">
                    {tag}
                  </span>
                ))
              }
            </div>
          </div>
        </div>
      </aside>
    </div>
  </main>

  <Footer lang={lang} />
</BaseLayout>
